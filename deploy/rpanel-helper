프로그램은 PORT 환경변수로 받은 포트에서 127.0.0.1 로 열어야 합니다.
  let port = std::env::var("PORT").unwrap_or("3000".into());
  // 예: axum::serve(TcpListener::bind(format!("127.0.0.1:{port}")).await?, app)
데이터베이스 주소 등은 패널의 환경변수 탭 값이 그대로 전달됩니다.
EOF
      ;;
    python)
      cat > "$root/app.py" <<'EOF'
