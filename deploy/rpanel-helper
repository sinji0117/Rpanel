site_password() {
  local slug="$1" user pw
  user="$(site_user_of "$slug")"; [[ -n "$user" ]] || die "사이트 유저가 없는 앱입니다: $slug"
  IFS= read -r pw || true
  [[ ${#pw} -ge 10 && ${#pw} -le 128 ]] || die "비밀번호는 10~128자여야 합니다"
  [[ "$pw" != *:* ]] || die "비밀번호에 ':' 를 쓸 수 없습니다"
  printf '%s:%s\n' "$user" "$pw" | chpasswd
  echo "password updated for $user"
}

# ───────────────────────── 사이트 계정 (SSH · SFTP) ─────────────────────────
# 기본 계정 = 사이트 유저. 추가 계정은 /etc/rpanel/site-accounts ("<slug> <user>") 에 등록되며
#   - 주 그룹이 사이트 그룹이고, ACL 로 사이트 파일(htdocs·logs)에 읽기·쓰기 권한을 받습니다.
#   - 홈은 /home/<계정> (0700), 안에 htdocs → 사이트 htdocs 링크.
# 접속 방식: ssh (셸 /bin/bash) | sftp (셸 nologin + rpanel-sftp 그룹 → sshd ForceCommand internal-sftp)
# 잠금: rpanel-locked 그룹 (sshd DenyGroups) — 비밀번호·키 모두 거부, 사이트 서비스는 그대로 동작
ACCOUNTS_REG="${RPANEL_TEST_ACCOUNTS_REG:-/etc/rpanel/site-accounts}"

extra_registered() { [[ -f $ACCOUNTS_REG ]] && grep -qx "$1 $2" "$ACCOUNTS_REG"; }

# 이 사이트에 속한 계정인지 (기본 또는 추가) — 아니면 중단
account_of_site() {
  local slug="$1" user="$2"
  valid_site_user "$user"
  [[ "$(site_user_of "$slug")" == "$user" ]] || extra_registered "$slug" "$user" || die "이 사이트의 계정이 아닙니다: $user"
}

ensure_access_groups() {
  getent group rpanel-sftp >/dev/null || groupadd --system rpanel-sftp
  getent group rpanel-locked >/dev/null || groupadd --system rpanel-locked
}

account_mode() { # <user> <ssh|sftp> <on|off>
  local user="$1" mode="$2" state="$3"
  [[ "$mode" == ssh || "$mode" == sftp ]] || die "접속 방식은 ssh 또는 sftp"
  [[ "$state" == on || "$state" == off ]] || die "상태는 on 또는 off"
  ensure_access_groups
  if [[ "$mode" == sftp ]]; then
    usermod -s /usr/sbin/nologin "$user" >/dev/null 2>&1 || true; usermod -aG rpanel-sftp "$user"
  else
    usermod -s /bin/bash "$user" >/dev/null 2>&1 || true; gpasswd -d "$user" rpanel-sftp >/dev/null 2>&1 || true
  fi
  if [[ "$state" == off ]]; then
    usermod -aG rpanel-locked "$user"
    pkill -u "$user" -x sshd 2>/dev/null || true   # 접속 중인 세션 종료 (사이트 서비스는 sshd 가 아니므로 그대로)
  else
    gpasswd -d "$user" rpanel-locked >/dev/null 2>&1 || true
  fi
}

site_account_create() {
  local slug="$1" user="$2" mode="$3" suser sroot shome pw=""
  valid_site_user "$user"
  suser="$(site_user_of "$slug")"; [[ -n "$suser" ]] || die "사이트 유저가 없는 앱입니다: $slug"
  id "$user" >/dev/null 2>&1 && die "시스템에 이미 있는 사용자입니다: $user"
  [[ ! -e "/home/$user" ]] || die "/home/$user 이(가) 이미 있습니다"
  IFS= read -r pw || true
  if [[ -n "$pw" ]]; then
    [[ ${#pw} -ge 10 && ${#pw} -le 128 && "$pw" != *:* ]] || die "비밀번호는 10~128자, ':' 없이"
  fi
  shome="/home/$suser"; sroot="$(site_root_of "$slug")"
  command -v setfacl >/dev/null || die "acl 패키지가 필요합니다 (apt install acl)"
  ensure_access_groups
  useradd --create-home --home-dir "/home/$user" --shell /bin/bash --gid "$suser" --groups "$SITES_GROUP" "$user"
  chmod 0700 "/home/$user"
  install -d -o "$user" -g "$suser" -m 0700 "/home/$user/.ssh"
  install -m 0600 -o "$user" -g "$suser" /dev/null "/home/$user/.ssh/authorized_keys"
  ln -sfn "$shome/htdocs" "/home/$user/htdocs"
  # 새로 만드는 파일을 그룹(사이트) 쓰기 가능으로 → 사이트 유저도 수정 가능
  printf '\n# rpanel: 사이트 파일을 사이트 유저와 함께 쓰도록\numask 002\n' | tee -a "/home/$user/.profile" "/home/$user/.bashrc" >/dev/null
  # 사이트 파일 읽기·쓰기 (기존 파일 + 앞으로 만들 파일). 새 파일은 사이트 유저도 계속 쓸 수 있게.
  for d in "$shome/htdocs" "$shome/logs"; do
    [[ -d "$d" ]] || continue
    setfacl -R -m "u:$user:rwX" "$d"
    find "$d" -type d -exec setfacl -m "d:u:$user:rwX,d:u:$suser:rwX" {} +
  done
  [[ -n "$pw" ]] && printf '%s:%s\n' "$user" "$pw" | chpasswd
  account_mode "$user" "$mode" on
  touch "$ACCOUNTS_REG"; chmod 0644 "$ACCOUNTS_REG"
  echo "$slug $user" >> "$ACCOUNTS_REG"
  echo "created site account $user ($mode) → $sroot"
}

site_account_update() { # <slug> <user> <ssh|sftp> <on|off>
  account_of_site "$1" "$2"
  account_mode "$2" "$3" "$4"
  echo "updated $2 ($3, $4)"
}

site_account_password() {
  local slug="$1" user="$2" pw
  account_of_site "$slug" "$user"
  IFS= read -r pw || true
  [[ ${#pw} -ge 10 && ${#pw} -le 128 ]] || die "비밀번호는 10~128자여야 합니다"
  [[ "$pw" != *:* ]] || die "비밀번호에 ':' 를 쓸 수 없습니다"
  printf '%s:%s\n' "$user" "$pw" | chpasswd
  echo "password updated for $user"
}

# SSH 공개키 목록 (stdin, 한 줄에 하나). 키 형식만 허용 — 옵션(command= 등)은 거부
site_account_keys() {
  local slug="$1" user="$2" line n=0 tmp
  account_of_site "$slug" "$user"
  tmp="$(mktemp)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    [[ -z "${line// }" || "$line" == \#* ]] && continue
    [[ "$line" =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com)\ [A-Za-z0-9+/]+={0,3}(\ [^[:cntrl:]]{0,200})?$ ]] \
      || { rm -f "$tmp"; die "SSH 공개키 형식이 아닙니다: ${line:0:40}…"; }
    echo "$line" >> "$tmp"; n=$((n + 1))
    (( n <= 50 )) || { rm -f "$tmp"; die "키는 50개까지입니다"; }
  done
  install -d -o "$user" -m 0700 "/home/$user/.ssh"
  install -m 0600 -o "$user" "$tmp" "/home/$user/.ssh/authorized_keys"
  rm -f "$tmp"
  echo "$n keys for $user"
}

site_account_delete() {
  local slug="$1" user="$2" suser
  valid_site_user "$user"
  extra_registered "$slug" "$user" || die "추가 계정이 아닙니다 (기본 계정은 사이트를 지울 때 함께 지워집니다): $user"
  suser="$(site_user_of "$slug")"
  pkill -u "$user" 2>/dev/null || true
  sleep 0.3
  for d in "/home/$suser/htdocs" "/home/$suser/logs"; do
    [[ -n "$suser" && -d "$d" ]] || continue
    setfacl -R -x "u:$user" "$d" 2>/dev/null || true
    find "$d" -type d -exec setfacl -x "d:u:$user" {} + 2>/dev/null || true
  done
  userdel --remove "$user" 2>/dev/null || userdel "$user"
  rm -rf --one-file-system "/home/$user"
  grep -vx "$slug $user" "$ACCOUNTS_REG" > "$ACCOUNTS_REG.tmp" || true
  mv "$ACCOUNTS_REG.tmp" "$ACCOUNTS_REG"; chmod 0644 "$ACCOUNTS_REG"
  echo "deleted site account $user"
}

site_delete() {
  local slug="$1" user extra
  # 추가 계정 먼저
  if [[ -f $ACCOUNTS_REG ]]; then
    for extra in $(awk -v s="$slug" '$1==s {print $2}' "$ACCOUNTS_REG"); do
      [[ "$extra" =~ ^[a-z][a-z0-9-]{2,31}$ ]] || continue
      site_account_delete "$slug" "$extra" >/dev/null || true
    done
  fi
  user="$(site_user_of "$slug")"
  [[ -n "$user" ]] || return 0
  valid_site_user "$user"
  id -nG "$user" 2>/dev/null | tr ' ' '\n' | grep -qx "$SITES_GROUP" || die "$user 는 rpanel 사이트 유저가 아닙니다"
  pkill -u "$user" 2>/dev/null || true
  sleep 0.5
  gpasswd -d www-data "$user" >/dev/null 2>&1 || true
  userdel --remove "$user" 2>/dev/null || userdel "$user"
  rm -rf --one-file-system "/home/$user"
  awk -v s="$slug" '$1!=s' "$SITES_REG" > "$SITES_REG.tmp"; mv "$SITES_REG.tmp" "$SITES_REG"; chmod 0644 "$SITES_REG"
  echo "deleted site user $user"
}

# ───────────────────────── SSL ─────────────────────────

valid_email() {
  [[ ${#1} -le 190 && "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "invalid email: '$1'"
}

ssl_issue() {
  local slug="$1" email="$2"; shift 2
  valid_email "$email"
  (( $# >= 1 && $# <= 20 )) || die "도메인이 필요합니다"
  local args=() d
  for d in "$@"; do valid_domain "$d"; args+=(-d "$d"); done
  command -v certbot >/dev/null || die "certbot 이 설치되어 있지 않습니다 (apt install certbot)"
  install -d -m 0755 "$ACME_ROOT"
  certbot certonly --webroot -w "$ACME_ROOT" --cert-name "rpanel-$slug" \
    --non-interactive --agree-tos -m "$email" --keep-until-expiring --expand "${args[@]}" 2>&1 \
    || die "Let's Encrypt 발급 실패 — 도메인 DNS 가 이 서버를 가리키는지, 80 포트가 열려 있는지 확인하세요"
  echo "issued rpanel-$slug"
}

ssl_custom() {
  local slug="$1" crt="$STAGING/$1.crt" key="$STAGING/$1.key" dir="/etc/rpanel/certs/$1"
  staged_raw "$crt"; staged_raw "$key"
  openssl x509 -in "$crt" -noout >/dev/null 2>&1 || { rm -f "$crt" "$key"; die "인증서(PEM)를 읽을 수 없습니다"; }
  openssl pkey -in "$key" -noout >/dev/null 2>&1 || { rm -f "$crt" "$key"; die "개인키(PEM)를 읽을 수 없습니다 (암호가 걸린 키는 지원하지 않습니다)"; }
  if [[ "$(openssl x509 -in "$crt" -noout -pubkey | openssl sha256)" != "$(openssl pkey -in "$key" -pubout | openssl sha256)" ]]; then
    rm -f "$crt" "$key"; die "인증서와 개인키가 서로 맞지 않습니다"
  fi
  install -d -m 0700 -o root -g root "$dir"
  install -m 0644 -o root -g root "$crt" "$dir/fullchain.pem"
  install -m 0600 -o root -g root "$key" "$dir/key.pem"
  rm -f "$crt" "$key"
  echo "installed custom certificate for $slug"
}

ssl_info() {
  local slug="$1" f
  for f in "/etc/letsencrypt/live/rpanel-$slug/fullchain.pem" "/etc/rpanel/certs/$slug/fullchain.pem"; do
    [[ -f "$f" ]] || continue
    echo "path=$f"
    openssl x509 -in "$f" -noout -enddate -issuer -subject 2>/dev/null | sed -E 's/^notAfter=/not_after=/; s/^issuer=/issuer=/; s/^subject=/subject=/'
    openssl x509 -in "$f" -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr -d ' ' | sed 's/^/san=/'
  done
}

ssl_remove() {
  local slug="$1"
  if command -v certbot >/dev/null && [[ -d "/etc/letsencrypt/live/rpanel-$slug" ]]; then
    certbot delete --cert-name "rpanel-$slug" --non-interactive >/dev/null 2>&1 || true
  fi
  rm -rf "/etc/rpanel/certs/$slug"
  echo "removed certificates for $slug"
}

# ───────────────────────── 패널 전용 도메인 ─────────────────────────
# 패널을 https://panel.example.com (443) 으로도 열 수 있게 — 설정 내용은 이 스크립트가 직접 만듦

PANEL_DOMAIN_CONF="rpanel-panel-domain.conf"
PANEL_UPSTREAM="${RPANEL_PANEL_UPSTREAM:-127.0.0.1:8090}"

# panel_domain_conf <domain> [cert key]  — 인증서가 없으면 80 포트(ACME)만
panel_domain_conf() {
  local domain="$1" cert="${2:-}" key="${3:-}" v6=0
  grep -qs 'listen \[::\]' "$AVAIL/rpanel-panel.conf" && v6=1
  echo "$MARK (panel domain) — 패널 설정 화면에서 바꿉니다"
  echo "server {"
  echo "    listen 80;"
  if ((v6)); then echo "    listen [::]:80;"; fi
  echo "    server_name $domain;"
  echo "    location ^~ /.well-known/acme-challenge/ {"
  echo "        root $ACME_ROOT;"
  echo '        default_type "text/plain";'
  echo '        try_files $uri =404;'
  echo "    }"
  echo "    location / {"
  if [[ -n "$cert" ]]; then
    echo '        return 301 https://$host$request_uri;'
  else
    echo '        return 503;'
  fi
  echo "    }"
  echo "}"
  [[ -n "$cert" ]] || return 0
  echo
  echo "server {"
  echo "    listen 443 ssl http2;"
  if ((v6)); then echo "    listen [::]:443 ssl http2;"; fi
  echo "    server_name $domain;"
  echo "    ssl_certificate     $cert;"
  echo "    ssl_certificate_key $key;"
  sed "s|__UPSTREAM__|$PANEL_UPSTREAM|g" <<'CONF'
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:rpanel_panel_domain:5m;

    root /usr/share/rpanel/www;
    index index.html;
    access_log /var/log/nginx/rpanel-panel-access.log;
    error_log  /var/log/nginx/rpanel-panel-error.log;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'" always;

    client_max_body_size 2m;

    include /etc/nginx/rpanel-panel-allow.con[f];

    location ^~ /api/hooks/ {
        allow all;
        proxy_pass http://__UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/api/apps/[0-9]+/files/upload$ {
        client_max_body_size 2048m;
        proxy_request_buffering off;
        proxy_pass http://__UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://__UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
CONF
}

panel_domain_install_conf() {
  local dst="$AVAIL/$PANEL_DOMAIN_CONF" link="$ENABLED/$PANEL_DOMAIN_CONF" backup="" tmp
  tmp="$(mktemp)"; panel_domain_conf "$@" > "$tmp"
  if [[ -f "$dst" ]]; then backup=$(mktemp); cp -p "$dst" "$backup"; fi
  install -m 0644 -o root -g root "$tmp" "$dst"; rm -f "$tmp"
  ln -sfn "$dst" "$link"
  if ! nginx -t 2>/tmp/rpanel-nginx-test.$$; then
    cat /tmp/rpanel-nginx-test.$$ >&2; rm -f /tmp/rpanel-nginx-test.$$
    if [[ -n "$backup" ]]; then mv "$backup" "$dst"; else rm -f "$dst" "$link"; fi
    die "nginx -t failed — 이전 설정으로 되돌렸습니다"
  fi
  rm -f /tmp/rpanel-nginx-test.$$ "${backup:-/nonexistent}"
  systemctl reload nginx
}

# 앱 사이트가 이미 쓰는 도메인이면 거부
panel_domain_conflict() {
  local domain="$1" f b
  for f in "$AVAIL"/rpanel-*.conf; do
    [[ -f "$f" ]] || continue
    b="$(basename "$f")"
    [[ "$b" == "$PANEL_DOMAIN_CONF" || "$b" == rpanel-panel.conf ]] && continue
    if grep -E '^[[:space:]]*server_name[[:space:]]' "$f" | tr -s ' ;\t' '\n' | grep -qxF "$domain"; then
      die "도메인 $domain 은(는) 이미 다른 사이트에서 사용 중입니다"
    fi
  done
}

panel_domain_set() {
  local domain="$1" email="$2"
  valid_domain "$domain"; valid_email "$email"
  panel_domain_conflict "$domain"
  command -v certbot >/dev/null || die "certbot 이 설치되어 있지 않습니다 (apt install certbot)"
  install -d -m 0755 "$ACME_ROOT"
  # 1) 80 포트로 ACME 경로를 먼저 열고  2) 인증서 발급  3) 443 설정
  panel_domain_install_conf "$domain"
  if ! certbot certonly --webroot -w "$ACME_ROOT" --cert-name rpanel-panel-domain \
      --non-interactive --agree-tos -m "$email" --keep-until-expiring --expand -d "$domain" 2>&1; then
    rm -f "$ENABLED/$PANEL_DOMAIN_CONF" "$AVAIL/$PANEL_DOMAIN_CONF"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
    die "Let's Encrypt 발급 실패 — 도메인 DNS 가 이 서버를 가리키는지, 80 포트가 열려 있는지 확인하세요"
  fi
  panel_domain_install_conf "$domain" /etc/letsencrypt/live/rpanel-panel-domain/fullchain.pem /etc/letsencrypt/live/rpanel-panel-domain/privkey.pem
  echo "panel domain https://$domain"
}

panel_domain_remove() {
  rm -f "$ENABLED/$PANEL_DOMAIN_CONF" "$AVAIL/$PANEL_DOMAIN_CONF"
  if command -v certbot >/dev/null && [[ -d /etc/letsencrypt/live/rpanel-panel-domain ]]; then
    certbot delete --cert-name rpanel-panel-domain --non-interactive >/dev/null 2>&1 || true
  fi
  if nginx -t >/dev/null 2>&1; then systemctl reload nginx; fi
  echo "panel domain removed"
}

# ───────────────────────── DB 서버 버전 (MariaDB · MongoDB · Redis) ─────────────────────────
# 더 높은 버전으로만 바꿉니다 (패널이 확인). 바꾸기 전에 전체 백업을 _engines 에 남깁니다.

valid_engine_version() {
  case "${1:-}:${2:-}" in
    mariadb:10.11|mariadb:11.4|mariadb:11.8|mongodb:8.0|mongodb:8.2|redis:7.0|redis:8) ;;
    *) die "db-engine: 고를 수 없는 버전입니다: ${1:-} ${2:-}" ;;
  esac
}

os_codename() {
  local c; c="$(. /etc/os-release 2>/dev/null; echo "${VERSION_CODENAME:-}")"
  [[ "$c" =~ ^[a-z]+$ ]] || die "OS 코드 이름을 알 수 없습니다"
  echo "$c"
}

env_value() { grep -E "^$1=" "$MONGO_ENV" 2>/dev/null | tail -n1 | cut -d= -f2-; }

apt_install_quiet() {
  DEBIAN_FRONTEND=noninteractive apt-get install -y -q -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confdef "$@"
}

engine_backup() {
  local engine="$1" dir stamp out cfg pw
  dir="$DATA/backups/_engines"; install -d -m 0750 -o root -g root "$dir"
  stamp="$(date +%Y%m%d-%H%M%S)"
  case "$engine" in
    mariadb)
      out="$dir/$stamp-mariadb-all.sql.gz"
      echo "▶ 전체 백업: $out" >&2
      mariadb-dump --all-databases --single-transaction --routines --events --triggers | gzip > "$out.part" \
        || { rm -f "$out.part"; die "MariaDB 백업 실패 — 버전을 바꾸지 않았습니다"; }
      ;;
    mongodb)
      out="$dir/$stamp-mongodb-all.archive.gz"
      echo "▶ 전체 백업: $out" >&2
      command -v mongodump >/dev/null || die "mongodump 가 없습니다"
      cfg="$(mongo_cfg)"
      mongodump --config "$cfg" --archive="$out.part" --gzip --quiet || { rm -f "$cfg" "$out.part"; die "MongoDB 백업 실패 — 버전을 바꾸지 않았습니다"; }
      rm -f "$cfg"
      ;;
    redis)
      out="$dir/$stamp-redis-dump.rdb"
      echo "▶ 전체 백업: $out" >&2
      pw="$(env_value REDIS_URL | sed -nE 's#^redis://[^:]*:([^@]*)@.*#\1#p')"
      REDISCLI_AUTH="$pw" redis-cli SAVE >/dev/null 2>&1 || echo "(SAVE 실패 — 마지막 저장본을 복사합니다)" >&2
      [[ -f /var/lib/redis/dump.rdb ]] || : > /var/lib/redis/dump.rdb
      cp /var/lib/redis/dump.rdb "$out.part" || die "Redis 백업 실패 — 버전을 바꾸지 않았습니다"
      ;;
  esac
  mv "$out.part" "$out"; chmod 0600 "$out"
  # 오래된 엔진 백업은 최근 5개만
  ls -1t "$dir"/*-"$engine"-* 2>/dev/null | tail -n +6 | xargs -r rm -f
}

db_engine_upgrade() {
  local engine="$1" v="$2" code
  valid_engine_version "$engine" "$v"
  code="$(os_codename)"
  command -v apt-get >/dev/null || die "apt-get 이 없습니다 (Ubuntu·Debian 만 지원)"
  engine_backup "$engine"
  install -d -m 0755 /etc/apt/keyrings
  case "$engine" in
    mariadb)
      if [[ "$v" != 10.11 ]]; then
        echo "▶ MariaDB $v 저장소 추가" >&2
        curl -fsSL --proto '=https' --max-time 60 https://mariadb.org/mariadb_release_signing_key.pgp -o /etc/apt/keyrings/mariadb-keyring.pgp \
          || die "MariaDB 저장소 키를 받지 못했습니다 (인터넷 연결 확인)"
        printf 'X-Repolib-Name: MariaDB\nTypes: deb\nURIs: https://dlm.mariadb.com/repo/mariadb-server/%s/repo/ubuntu\nSuites: %s\nComponents: main\nSigned-By: /etc/apt/keyrings/mariadb-keyring.pgp\n' "$v" "$code" \
          > /etc/apt/sources.list.d/mariadb.sources
      fi
      apt-get update -q >&2 || die "apt-get update 실패"
      echo "▶ MariaDB $v 설치 (데이터는 그대로)" >&2
      apt_install_quiet mariadb-server mariadb-client >&2 || die "MariaDB $v 설치 실패 — 백업: $DATA/backups/_engines"
      systemctl restart mariadb
      for _ in $(seq 1 60); do mariadb -e 'SELECT 1' >/dev/null 2>&1 && break; sleep 1; done
      echo "▶ mariadb-upgrade" >&2
      mariadb-upgrade >&2 2>&1 || true
      echo "OK $(mariadb -N -e 'SELECT VERSION()')"
      ;;
    mongodb)
      echo "▶ MongoDB $v 저장소 추가" >&2
      curl -fsSL --proto '=https' --max-time 60 "https://www.mongodb.org/static/pgp/server-$v.asc" | gpg --dearmor --yes -o "/usr/share/keyrings/mongodb-server-$v.gpg" \
        || die "MongoDB 저장소 키를 받지 못했습니다"
      echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-$v.gpg ] https://repo.mongodb.org/apt/ubuntu $code/mongodb-org/$v multiverse" \
        > "/etc/apt/sources.list.d/mongodb-org-$v.list"
      apt-get update -q >&2 || die "apt-get update 실패"
      echo "▶ MongoDB $v 설치 (데이터는 그대로)" >&2
      apt_install_quiet mongodb-org >&2 || die "MongoDB $v 설치 실패 — 백업: $DATA/backups/_engines"
      systemctl restart mongod
      for _ in $(seq 1 60); do (echo > /dev/tcp/127.0.0.1/27017) 2>/dev/null && break; sleep 1; done
      echo "OK $(mongod --version | awk 'NR==1{print $3}')"
      ;;
    redis)
      if [[ "$v" == 8 ]]; then
        echo "▶ Redis 저장소(packages.redis.io) 추가" >&2
        curl -fsSL --proto '=https' --max-time 60 https://packages.redis.io/gpg | gpg --dearmor --yes -o /usr/share/keyrings/redis-archive-keyring.gpg \
          || die "Redis 저장소 키를 받지 못했습니다"
        echo "deb [signed-by=/usr/share/keyrings/redis-archive-keyring.gpg] https://packages.redis.io/deb $code main" > /etc/apt/sources.list.d/redis.list
      fi
      apt-get update -q >&2 || die "apt-get update 실패"
      echo "▶ Redis $v 설치 (데이터·설정은 그대로)" >&2
      apt_install_quiet redis-server redis-tools >&2 || die "Redis $v 설치 실패 — 백업: $DATA/backups/_engines"
      systemctl restart redis-server
      for _ in $(seq 1 30); do (echo > /dev/tcp/127.0.0.1/6379) 2>/dev/null && break; sleep 1; done
      echo "OK $(redis-server --version | sed -nE 's/.*v=([0-9.]+).*/\1/p')"
      ;;
  esac
}

# 낮은 버전으로 바꾸기 — 사용자가 만든 DB 가 없을 때만 패널이 호출합니다.
# 데이터 파일은 낮은 버전이 읽지 못하므로: (MariaDB) 패널 DB·계정을 SQL 로 덤프 → 데이터 폴더를 옆으로 옮김 → 패키지 다시 설치 → 복원
#                                         (MongoDB) 패널이 featureCompatibilityVersion 을 먼저 내림 → 패키지만 다시 설치
#                                         (Redis)   dump.rdb 를 옆으로 옮김(세션은 다시 로그인) → 패키지 다시 설치
db_engine_downgrade() {
  local engine="$1" v="$2" code stamp keep f
  valid_engine_version "$engine" "$v"
  code="$(os_codename)"
  command -v apt-get >/dev/null || die "apt-get 이 없습니다 (Ubuntu·Debian 만 지원)"
  engine_backup "$engine"
  stamp="$(date +%Y%m%d-%H%M%S)"
  keep="$DATA/backups/_engines/$stamp-$engine-downgrade"
  install -d -m 0700 "$keep"
  install -d -m 0755 /etc/apt/keyrings
  case "$engine" in
    mariadb)
      local dbs
      dbs="$(mariadb -N -e "SELECT schema_name FROM information_schema.schemata WHERE schema_name NOT IN ('mysql','information_schema','performance_schema','sys')" | tr '\n' ' ')"
      echo "▶ 데이터베이스·계정 덤프: ${dbs:-(없음)}" >&2
      mariadb-dump --system=users > "$keep/users.sql" || die "계정 덤프 실패 — 바꾸지 않았습니다"
      if [[ -n "${dbs// /}" ]]; then
        # shellcheck disable=SC2086
        mariadb-dump --databases $dbs --single-transaction --routines --events --triggers > "$keep/databases.sql" || die "DB 덤프 실패 — 바꾸지 않았습니다"
      fi
      cp -a /etc/mysql/mariadb.conf.d "$keep/conf.d"
      systemctl stop mariadb
      mv /var/lib/mysql "$keep/datadir"
      echo "▶ MariaDB 패키지 제거 (데이터 폴더는 $keep/datadir 에 보관)" >&2
      DEBIAN_FRONTEND=noninteractive apt-get purge -y -q 'mariadb-server*' 'mariadb-client*' mariadb-common >&2 || true
      if [[ "$v" == 10.11 ]]; then
        rm -f /etc/apt/sources.list.d/mariadb.sources
      else
        curl -fsSL --proto '=https' --max-time 60 https://mariadb.org/mariadb_release_signing_key.pgp -o /etc/apt/keyrings/mariadb-keyring.pgp \
          || die "MariaDB 저장소 키를 받지 못했습니다"
        printf 'X-Repolib-Name: MariaDB\nTypes: deb\nURIs: https://dlm.mariadb.com/repo/mariadb-server/%s/repo/ubuntu\nSuites: %s\nComponents: main\nSigned-By: /etc/apt/keyrings/mariadb-keyring.pgp\n' "$v" "$code" \
          > /etc/apt/sources.list.d/mariadb.sources
      fi
      apt-get update -q >&2 || die "apt-get update 실패"
      echo "▶ MariaDB $v 설치" >&2
      apt_install_quiet mariadb-server mariadb-client >&2 || die "MariaDB $v 설치 실패 — 보관본: $keep"
      for f in z-rpanel-bind.cnf 99-tuning.cnf; do
        [[ -f "$keep/conf.d/$f" ]] && cp "$keep/conf.d/$f" /etc/mysql/mariadb.conf.d/
      done
      systemctl restart mariadb
      for _ in $(seq 1 60); do mariadb -e 'SELECT 1' >/dev/null 2>&1 && break; sleep 1; done
      echo "▶ 계정·데이터베이스 복원" >&2
      # 덤프한 쪽이 더 새 버전이라 남기는 '샌드박스' 첫 줄은 지움
      sed -i '1{/^\/\*M!999999/d}' "$keep/users.sql" "$keep/databases.sql" 2>/dev/null || true
      mariadb < "$keep/users.sql" >&2 || echo "(일부 계정 복원 경고 — 계속)" >&2
      [[ -f "$keep/databases.sql" ]] && { mariadb < "$keep/databases.sql" || die "DB 복원 실패 — 덤프: $keep/databases.sql"; }
      mariadb -e 'FLUSH PRIVILEGES' || true
      echo "OK $(mariadb -N -e 'SELECT VERSION()')"
      ;;
    mongodb)
      cp -a /etc/mongod.conf "$keep/mongod.conf"
      systemctl stop mongod
      echo "▶ MongoDB 패키지 제거 (데이터 /var/lib/mongodb 는 그대로)" >&2
      DEBIAN_FRONTEND=noninteractive apt-get purge -y -q 'mongodb-org*' >&2 || true
      for f in /etc/apt/sources.list.d/mongodb-org-*.list; do
        [[ -e "$f" && "$f" != "/etc/apt/sources.list.d/mongodb-org-$v.list" ]] && rm -f "$f"
      done
      curl -fsSL --proto '=https' --max-time 60 "https://www.mongodb.org/static/pgp/server-$v.asc" | gpg --dearmor --yes -o "/usr/share/keyrings/mongodb-server-$v.gpg" \
        || die "MongoDB 저장소 키를 받지 못했습니다"
      echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-$v.gpg ] https://repo.mongodb.org/apt/ubuntu $code/mongodb-org/$v multiverse" \
        > "/etc/apt/sources.list.d/mongodb-org-$v.list"
      apt-get update -q >&2 || die "apt-get update 실패"
      echo "▶ MongoDB $v 설치" >&2
      apt_install_quiet mongodb-org >&2 || die "MongoDB $v 설치 실패 — 설정 보관본: $keep"
      cp "$keep/mongod.conf" /etc/mongod.conf
      chown -R mongodb:mongodb /var/lib/mongodb 2>/dev/null || true
      systemctl enable mongod >/dev/null 2>&1 || true
      systemctl restart mongod
      for _ in $(seq 1 60); do (echo > /dev/tcp/127.0.0.1/27017) 2>/dev/null && break; sleep 1; done
      echo "OK $(mongod --version | awk 'NR==1{print $3}')"
      ;;
    redis)
      cp -a /etc/redis "$keep/etc-redis"
      systemctl stop redis-server
      [[ -f /var/lib/redis/dump.rdb ]] && mv /var/lib/redis/dump.rdb "$keep/dump.rdb"
      echo "▶ Redis 패키지 제거 (저장 파일은 $keep 에 보관 — 패널 로그인은 다시 해야 합니다)" >&2
      DEBIAN_FRONTEND=noninteractive apt-get purge -y -q redis-server redis-tools redis >&2 || true
      rm -f /etc/apt/sources.list.d/redis.list
      apt-get update -q >&2 || die "apt-get update 실패"
      echo "▶ Redis $v 설치" >&2
      apt_install_quiet redis-server redis-tools >&2 || die "Redis $v 설치 실패 — 설정 보관본: $keep"
      cp -a "$keep/etc-redis/." /etc/redis/
      chown -R redis:redis /etc/redis 2>/dev/null || true
      systemctl restart redis-server
      for _ in $(seq 1 30); do (echo > /dev/tcp/127.0.0.1/6379) 2>/dev/null && break; sleep 1; done
      echo "OK $(redis-server --version | sed -nE 's/.*v=([0-9.]+).*/\1/p')"
      ;;
  esac
}

# ───────────────────────── 패널 접속 허용 IP ─────────────────────────
# Nginx 의 allow/deny 로 막습니다 (Git 웹훅 /api/hooks/ 는 예외). ufw 는 이 대역을 열어 줍니다.

PANEL_ALLOW_CONF="${RPANEL_TEST_PANEL_ALLOW:-/etc/nginx/rpanel-panel-allow.conf}"

valid_cidr() {
  local c="$1" ip bits
  ip="${c%/*}"; bits=""; [[ "$c" == */* ]] && bits="${c#*/}"
  if [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]]; then
    local o; for o in "${BASH_REMATCH[@]:1}"; do (( o <= 255 )) || die "잘못된 IP: $c"; done
    [[ -z "$bits" ]] || { [[ "$bits" =~ ^[0-9]{1,2}$ ]] && (( bits <= 32 )); } || die "잘못된 대역: $c"
  elif [[ "$ip" =~ ^[0-9a-fA-F:]+$ && "$ip" == *:* && ${#ip} -le 39 ]]; then
    [[ -z "$bits" ]] || { [[ "$bits" =~ ^[0-9]{1,3}$ ]] && (( bits <= 128 )); } || die "잘못된 대역: $c"
  else
    die "잘못된 IP: $c"
  fi
}

panel_port() {
  local p; p="$(sed -nE 's/^\s*listen ([0-9]+) ssl.*/\1/p' "$AVAIL/rpanel-panel.conf" 2>/dev/null | head -n1)"
  echo "${p:-8443}"
}

# panel-access any | CIDR[,CIDR…]
panel_access() {
  local list="${1:-}" tmp c port
  [[ -n "$list" ]] || die "panel-access: any 또는 IP 목록이 필요합니다"
  tmp="$(mktemp)"
  echo "$MARK — 패널 접속 허용 IP (설정 화면에서 바꿉니다)" > "$tmp"
  if [[ "$list" != any ]]; then
    (( ${#list} <= 2000 )) || die "목록이 너무 깁니다"
    [[ "$list" =~ ^[0-9a-fA-F.:/,]+$ ]] || die "잘못된 IP 목록: $list"
    for c in ${list//,/ }; do valid_cidr "$c"; echo "allow $c;" >> "$tmp"; done
    echo "allow 127.0.0.1;" >> "$tmp"
    echo "deny all;" >> "$tmp"
  fi
  install -m 0644 "$tmp" "$PANEL_ALLOW_CONF"; rm -f "$tmp"
  [[ -n "${RPANEL_TEST_PANEL_ALLOW:-}" ]] && return 0
  if ! nginx -t >/dev/null 2>&1; then
    : > "$PANEL_ALLOW_CONF"; nginx -t >/dev/null 2>&1 && systemctl reload nginx
    die "nginx -t 실패 — 접속 제한을 풀었습니다"
  fi
  systemctl reload nginx
  # ufw 가 켜져 있으면 패널 포트를 그 대역에 열어 줌 (실제 제한은 Nginx 가 함)
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
    port="$(panel_port)"
    if [[ "$list" == any ]]; then
      ufw allow "$port/tcp" >/dev/null || true
    else
      for c in ${list//,/ }; do ufw allow from "$c" to any port "$port" proto tcp >/dev/null || true; done
    fi
  fi
  echo "panel access: $list"
}

# ───────────────────────── 파일 사이트 백업 ─────────────────────────

backup_files() {
  local slug="$1" stamp="$2" dir out user
  valid_stamp "$stamp"
  user="$(site_user_of "$slug")"; [[ -n "$user" ]] || die "사이트 유저가 없는 앱입니다"
  dir="$(backup_dir "$slug")"; out="$dir/$stamp-files.tar.gz"
  tar -C "/home/$user" -czf "$out.part" htdocs || { rm -f "$out.part"; die "tar 실패"; }
  mv "$out.part" "$out"
  finish_file "$out"
}

restore_files() {
  local slug="$1" file="$2" path user
  valid_backup_file "$file"; [[ "$file" == *-files.tar.gz ]] || die "파일 백업이 아닙니다"
  user="$(site_user_of "$slug")"; [[ -n "$user" ]] || die "사이트 유저가 없는 앱입니다"
  path="$BACKUPS/$slug/$file"; [[ -f "$path" && ! -L "$path" ]] || die "백업 파일이 없습니다"
  if tar -tzf "$path" | grep -Ev '^htdocs(/|$)' | grep -q . ; then die "아카이브에 허용되지 않은 경로가 있습니다"; fi
  if tar -tzf "$path" | grep -Eq '(^|/)\.\.(/|$)'; then die "아카이브에 .. 경로가 있습니다"; fi
  if tar -tvzf "$path" | grep -Eq '^[lhbcp]| link to '; then die "아카이브에 링크·특수 파일이 있습니다"; fi
  rm -rf --one-file-system "/home/$user/htdocs"
  # 사이트 유저 권한으로 풀어 소유권을 맞춤 (백업 파일은 사이트 유저가 못 읽으므로 root 가 stdin 으로 넘김)
  runuser -u "$user" -- tar -C "/home/$user" --no-same-owner -xzf - < "$path"
  echo "restored files from $file"
}

# ───────────────────────── Nginx 로그 ─────────────────────────

nginx_log() {
  local slug="$1" kind="$2" n="$3"
  [[ "$kind" == access || "$kind" == error ]] || die "kind must be access|error"
  [[ "$n" =~ ^[0-9]{1,5}$ ]] && (( n >= 1 && n <= 20000 )) || die "lines must be 1..20000"
  tail -n "$n" "/var/log/nginx/rpanel-$slug-$kind.log" 2>/dev/null || true
}

# ───────────────────────── 언어 런타임 (Python · Node.js · Java) ─────────────────────────
# /opt/rpanel/runtimes 아래에만 설치 (root 소유, 모두 읽기·실행 가능 → 사이트 유저도 사용)
#   python: uv 의 standalone 빌드 → bin/python3.X 링크
#   node:   nodejs.org 공식 tarball (SHA-256 확인) → node/<major>
#   java:   Eclipse Temurin JDK (api.adoptium.net, SHA-256 확인) → java/<major>

RT="${RPANEL_TEST_RUNTIMES:-/opt/rpanel/runtimes}"   # 테스트용 덮어쓰기

valid_runtime() {
  local lang="$1" v="$2"
  case "$lang" in
    python) [[ "$v" =~ ^3\.([0-9]{1,2})$ ]] && (( BASH_REMATCH[1] >= 8 && BASH_REMATCH[1] <= 20 )) || die "invalid python version: '$v'" ;;
    node)   [[ "$v" =~ ^[1-9][0-9]$ ]] && (( v >= 18 && v <= 40 )) || die "invalid node version: '$v'" ;;
    java)   [[ "$v" =~ ^(8|[1-9][0-9])$ ]] && (( v == 8 || (v >= 11 && v <= 40) )) || die "invalid java version: '$v'" ;;
    *) die "invalid runtime: '$lang' (python|node|java)" ;;
  esac
}

rt_arch() {
  case "$(uname -m)" in
    x86_64) echo "$1" | cut -d, -f1 ;;
    aarch64|arm64) echo "$1" | cut -d, -f2 ;;
    *) die "unsupported cpu: $(uname -m)" ;;
  esac
}

# 받은 파일을 SHA-256 으로 확인
rt_fetch() {
  local url="$1" out="$2"
  curl -fsSL --proto '=https' --retry 2 --max-time 600 -o "$out" "$url" || die "download failed: $url"
}

uv_bin() {
  local uv="$RT/uv/uv"
  if [[ ! -x $uv ]]; then
    local a; a=$(rt_arch x86_64,aarch64)
    local name="uv-$a-unknown-linux-gnu" tmp
    tmp=$(mktemp -d)
    echo "uv 설치 (Python 설치 도구)" >&2
    rt_fetch "https://github.com/astral-sh/uv/releases/latest/download/$name.tar.gz" "$tmp/uv.tgz"
    rt_fetch "https://github.com/astral-sh/uv/releases/latest/download/$name.tar.gz.sha256" "$tmp/uv.sha256"
    echo "$(awk '{print $1}' "$tmp/uv.sha256")  $tmp/uv.tgz" | sha256sum -c --quiet - || { rm -rf "$tmp"; die "uv checksum mismatch"; }
    tar -xzf "$tmp/uv.tgz" -C "$tmp"
    install -d -m 0755 "$RT/uv"
    install -m 0755 "$tmp/$name/uv" "$uv"
    rm -rf "$tmp"
  fi
  echo "$uv"
}

uv_env() {
  export UV_PYTHON_INSTALL_DIR="$RT/python" UV_PYTHON_BIN_DIR="$RT/.uv-bin" UV_CACHE_DIR="$RT/.cache/uv" \
    UV_NO_CONFIG=1 UV_PYTHON_PREFERENCE=only-managed UV_NO_MODIFY_PATH=1
}

runtime_install() {
  local lang="$1" v="$2"
  valid_runtime "$lang" "$v"
  install -d -m 0755 "$RT" "$RT/bin"
  case "$lang" in
    python)
      local uv; uv=$(uv_bin); uv_env
      "$uv" python install "$v" >&2 || die "python $v install failed"
      local py; py=$("$uv" python find "$v") || die "python $v not found after install"
      py=$(readlink -f "$py")
      [[ "$py" == "$RT/python/"* && -x "$py" ]] || die "unexpected python path: $py"
      chmod -R a+rX "$RT/python"
      ln -sfn "$py" "$RT/bin/python$v"
      echo "OK $("$RT/bin/python$v" --version 2>&1)"
      ;;
    node)
      local a; a=$(rt_arch x64,arm64)
      local ver index
      index=$(curl -fsSL --proto '=https' --max-time 60 https://nodejs.org/dist/index.json) \
        || die "nodejs.org 에 접속하지 못했습니다 — 서버 인터넷 연결을 확인하세요"
      ver=$(printf '%s' "$index" | python3 -c 'import json,sys; m="v"+sys.argv[1]+"."; print(next(r["version"] for r in json.load(sys.stdin) if r["version"].startswith(m)))' "$v") \
        || die "node $v: 출시된 버전을 찾지 못했습니다"
      [[ "$ver" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "bad node version: $ver"
      local f="node-$ver-linux-$a.tar.xz" tmp
      tmp=$(mktemp -d)
      echo "Node.js $ver 내려받는 중" >&2
      rt_fetch "https://nodejs.org/dist/$ver/$f" "$tmp/$f"
      rt_fetch "https://nodejs.org/dist/$ver/SHASUMS256.txt" "$tmp/SHASUMS256.txt"
      (cd "$tmp" && grep " $f\$" SHASUMS256.txt | sha256sum -c --quiet -) || { rm -rf "$tmp"; die "node checksum mismatch"; }
      install -d -m 0755 "$RT/node"
      rm -rf "$RT/node/.$v.new"
      mkdir "$RT/node/.$v.new"
      tar -xJf "$tmp/$f" -C "$RT/node/.$v.new" --strip-components=1 --no-same-owner
      rm -rf "$tmp"
      chmod -R a+rX "$RT/node/.$v.new"
      rm -rf "$RT/node/$v"
      mv "$RT/node/.$v.new" "$RT/node/$v"
      echo "OK $("$RT/node/$v/bin/node" --version)"
      ;;
    java)
      local a; a=$(rt_arch x64,aarch64)
      local meta info link sum name
      meta=$(curl -fsSL --proto '=https' --max-time 60 \
        "https://api.adoptium.net/v3/assets/latest/$v/hotspot?architecture=$a&image_type=jdk&os=linux&vendor=eclipse") \
        || die "api.adoptium.net 에 접속하지 못했습니다 — 서버 인터넷 연결을 확인하세요"
      info=$(printf '%s' "$meta" | python3 -c 'import json,sys
r = json.load(sys.stdin)[0]
p = r["binary"]["package"]
print(p["link"]); print(p["checksum"]); print(r["release_name"])') \
        || die "java $v: 출시된 JDK 를 찾지 못했습니다"
      link=$(sed -n 1p <<<"$info"); sum=$(sed -n 2p <<<"$info"); name=$(sed -n 3p <<<"$info")
      [[ "$link" =~ ^https://(github\.com/adoptium/|objects\.githubusercontent\.com/)[A-Za-z0-9._/%+-]+\.tar\.gz$ ]] || die "bad jdk link: $link"
      [[ "$sum" =~ ^[0-9a-f]{64}$ ]] || die "bad jdk checksum: $sum"
      [[ "$name" =~ ^jdk[A-Za-z0-9._+-]+$ ]] || die "bad jdk release: $name"
      local tmp; tmp=$(mktemp -d)
      echo "Java (Temurin $name) 내려받는 중" >&2
      rt_fetch "$link" "$tmp/jdk.tar.gz"
      echo "$sum  $tmp/jdk.tar.gz" | sha256sum -c --quiet - || { rm -rf "$tmp"; die "jdk checksum mismatch"; }
      install -d -m 0755 "$RT/java"
      rm -rf "$RT/java/.$v.new"
      mkdir "$RT/java/.$v.new"
      tar -xzf "$tmp/jdk.tar.gz" -C "$RT/java/.$v.new" --strip-components=1 --no-same-owner
      rm -rf "$tmp"
      [[ -x "$RT/java/.$v.new/bin/java" ]] || { rm -rf "$RT/java/.$v.new"; die "bin/java 가 없는 JDK 압축 파일입니다"; }
      chmod -R a+rX "$RT/java/.$v.new"
      rm -rf "$RT/java/$v"
      mv "$RT/java/.$v.new" "$RT/java/$v"
      echo "OK $("$RT/java/$v/bin/java" -version 2>&1 | grep -m1 ' version ')"
      ;;
  esac
}

runtime_remove() {
  local lang="$1" v="$2"
  valid_runtime "$lang" "$v"
  case "$lang" in
    python)
      rm -f "$RT/bin/python$v"
      if [[ -x $RT/uv/uv ]]; then uv_env; "$RT/uv/uv" python uninstall "$v" >&2 || true; fi
      ;;
    node) rm -rf --one-file-system "$RT/node/$v" ;;
    java) rm -rf --one-file-system "$RT/java/$v" ;;
  esac
  echo "removed $lang $v"
}

# ───────────────────────── 저장 위치 (백업 · 프로젝트) ─────────────────────────
# 데이터를 새 위치로 옮긴 뒤 원래 경로(/var/lib/rpanel/…)에 bind mount 합니다.
# 패널·앱·Nginx 는 계속 원래 경로를 쓰므로 다른 설정은 바뀌지 않습니다.
# 마운트는 systemd .mount 유닛으로 (재부팅 후에도 유지, 호스트 네임스페이스에서 실행).
#   /etc/rpanel/storage : "<kind> <path>" 한 줄씩 (helper 만 수정, 기본 위치면 줄 없음)

STORAGE_REG="${RPANEL_TEST_STORAGE_REG:-/etc/rpanel/storage}"

storage_subdirs() {
  case "$1" in
    backups)  echo "backups" ;;
    projects) echo "apps www builds" ;;
    *) die "invalid storage kind: '$1'" ;;
  esac
}

storage_get() { [[ -f $STORAGE_REG ]] && awk -v k="$1" '$1==k {print $2; exit}' "$STORAGE_REG" || true; }

# 새 위치 안에서 각 하위 폴더가 놓일 곳
storage_dst() {
  local kind="$1" base="$2" sub="$3"
  if [[ $kind == backups ]]; then echo "$base"; else echo "$base/$sub"; fi
}

valid_storage_path() {
  local p="${1:-}"
  [[ "$p" =~ ^/[A-Za-z0-9._/-]{1,200}$ ]] || die "경로는 / 로 시작하고 영문·숫자·. _ - / 만 쓸 수 있습니다: '$p'"
  [[ "$p" != *//* && "$p" != */ && "$p" != */./* && "$p" != */../* && "$p" != */. && "$p" != */.. ]] \
    || die "경로가 올바르지 않습니다: $p"
  case "$p/" in
    /bin/*|/boot/*|/dev/*|/etc/*|/lib/*|/lib32/*|/lib64/*|/libx32/*|/proc/*|/root/*|/run/*|/sbin/*|/sys/*|/usr/*|/tmp/*|/home/*|/snap/*|/lost+found/*|/var/*)
      die "시스템 폴더 안은 쓸 수 없습니다 (/srv, /data, /mnt 등을 쓰세요): $p" ;;
  esac
}

# 다른 종류의 위치와 겹치면 안 됨
storage_no_overlap() {
  local kind="$1" p="$2" other o
  for other in backups projects; do
    [[ $other == "$kind" ]] && continue
    o="$(storage_get "$other")"; [[ -n "$o" ]] || continue
    [[ "$p" == "$o" || "$p/" == "$o/"* || "$o/" == "$p/"* ]] && die "$other 위치($o)와 겹칩니다: $p"
  done
  return 0
}

storage_set() {
  local kind="${1:-}" new="${2:-}" cur subs sub dst unit fs ancestor need avail n
  local -a stopped=() olds=() news=()
  subs="$(storage_subdirs "$kind")"
  cur="$(storage_get "$kind")"
  [[ "$new" == default ]] && new=""
  if [[ -n "$new" ]]; then
    valid_storage_path "$new"
    storage_no_overlap "$kind" "$new"
  fi
  [[ "$new" != "$cur" ]] || die "이미 그 위치입니다"
  [[ -n "$new" && -n "$cur" && ( "$new/" == "$cur/"* || "$cur/" == "$new/"* ) ]] && die "지금 위치와 겹치는 경로는 고를 수 없습니다"

  if [[ -n "$new" ]]; then
    # 존재하면 비어 있는 폴더여야 함 (lost+found 만 있는 새 디스크는 허용), 심볼릭 링크 금지
    ancestor="$new"; while [[ ! -e "$ancestor" ]]; do ancestor="$(dirname "$ancestor")"; done
    [[ "$(realpath -e "$ancestor")" == "$ancestor" ]] || die "경로에 심볼릭 링크가 있습니다: $ancestor"
    if [[ -e "$new" ]]; then
      [[ -d "$new" ]] || die "폴더가 아닙니다: $new"
      [[ -z "$(ls -A "$new" | grep -vx 'lost+found' || true)" ]] || die "비어 있는 폴더만 고를 수 있습니다: $new"
    fi
    fs="$(stat -f -c %T "$ancestor")"
    case "$fs" in
      msdos|vfat|exfat|ntfs|ntfs3|fuseblk|tmpfs|ramfs) die "$fs 파일시스템은 쓸 수 없습니다 (권한·소유자를 저장하지 못하거나 재부팅하면 사라짐)" ;;
    esac
    need=0
    for sub in $subs; do
      n="$(du -sb --one-file-system "$DATA/$sub" 2>/dev/null | cut -f1 || true)"
      need=$(( need + ${n:-0} ))
    done
    avail=$(( $(stat -f -c '%a * %S' "$ancestor") ))
    (( need + need / 20 + 104857600 < avail )) || die "공간이 부족합니다: 필요 약 $(( need / 1048576 ))MB, 남은 공간 $(( avail / 1048576 ))MB"
    echo "▶ 옮길 데이터: 약 $(( need / 1048576 ))MB → $new ($fs, 남은 공간 $(( avail / 1048576 ))MB)" >&2
  else
    echo "▶ 기본 위치($DATA)로 되돌립니다" >&2
  fi

  command -v rsync >/dev/null || apt_install_quiet rsync >&2 || die "rsync 를 설치하지 못했습니다"
  # 1차 복사 (서비스는 계속 실행)
  for sub in $subs; do
    install -d -m 0755 "$DATA/$sub"
    if [[ -n "$new" ]]; then dst="$(storage_dst "$kind" "$new" "$sub")"; else dst="$DATA/.storage-$sub.new"; fi
    install -d -m 0755 "$dst"
    news+=("$dst")
    echo "▶ 복사: $DATA/$sub → $dst" >&2
    rsync -aH --numeric-ids --delete "$DATA/$sub/" "$dst/" >&2 \
      || { for d in "${news[@]}"; do [[ -n "$new" ]] || rm -rf --one-file-system "$d"; done; die "복사 실패 — 아무것도 바꾸지 않았습니다"; }
  done

  # 프로젝트: 앱을 잠깐 멈추고 마지막으로 맞춤
  if [[ $kind == projects ]]; then
    mapfile -t stopped < <(systemctl list-units --type=service --state=active --plain --no-legend 'rpanel-app-*.service' 2>/dev/null | awk '{print $1}')
    if (( ${#stopped[@]} )); then
      echo "▶ 앱 ${#stopped[@]}개 잠시 중지" >&2
      systemctl stop "${stopped[@]}" || true
    fi
  fi
  for sub in $subs; do
    if [[ -n "$new" ]]; then dst="$(storage_dst "$kind" "$new" "$sub")"; else dst="$DATA/.storage-$sub.new"; fi
    rsync -aH --numeric-ids --delete "$DATA/$sub/" "$dst/" >&2 || {
      (( ${#stopped[@]} )) && systemctl start "${stopped[@]}" || true
      die "복사 실패 — 아무것도 바꾸지 않았습니다"
    }
  done

  # 바꾸기
  for sub in $subs; do
    unit="$(systemd-escape -p --suffix=mount "$DATA/$sub")"
    if [[ -n "$cur" ]]; then
      systemctl disable --now "$unit" >&2 || die "$DATA/$sub 마운트를 풀지 못했습니다"
      rm -f "/etc/systemd/system/$unit"
      for _ in $(seq 40); do mountpoint -q "$DATA/$sub" || break; sleep 0.25; done
      mountpoint -q "$DATA/$sub" && die "$DATA/$sub 마운트가 풀리지 않았습니다"
      olds+=("$(storage_dst "$kind" "$cur" "$sub")")
    else
      rm -rf --one-file-system "$DATA/.storage-old-$sub"
      mv "$DATA/$sub" "$DATA/.storage-old-$sub"
      olds+=("$DATA/.storage-old-$sub")
    fi
    if [[ -n "$new" ]]; then
      dst="$(storage_dst "$kind" "$new" "$sub")"
      [[ -d "$DATA/$sub" ]] || install -d -m 0755 "$DATA/$sub"
      cat > "/etc/systemd/system/$unit" <<UNIT
$MARK
[Unit]
Description=Rpanel storage: $DATA/$sub
RequiresMountsFor=$dst
Before=rpanel.service

[Mount]
What=$dst
Where=$DATA/$sub
Type=none
Options=bind

[Install]
WantedBy=multi-user.target
UNIT
      systemctl daemon-reload
      systemctl enable --now "$unit" >&2 || die "$unit 을(를) 켜지 못했습니다 — 데이터는 $dst 에 있습니다"
      for _ in $(seq 40); do mountpoint -q "$DATA/$sub" && break; sleep 0.25; done
      mountpoint -q "$DATA/$sub" || die "$DATA/$sub 마운트가 보이지 않습니다"
    else
      rmdir "$DATA/$sub" 2>/dev/null || mv "$DATA/$sub" "$DATA/.storage-mnt-$sub"
      mv "$DATA/.storage-$sub.new" "$DATA/$sub"
    fi
  done
  systemctl daemon-reload

  # 기록
  install -d -m 0755 "$(dirname "$STORAGE_REG")"
  { [[ -f $STORAGE_REG ]] && awk -v k="$kind" '$1!=k' "$STORAGE_REG"; [[ -n "$new" ]] && echo "$kind $new"; } > "$STORAGE_REG.tmp" || true
  chmod 0644 "$STORAGE_REG.tmp"; mv "$STORAGE_REG.tmp" "$STORAGE_REG"

  if (( ${#stopped[@]} )); then
    echo "▶ 앱 다시 시작" >&2
    systemctl start "${stopped[@]}" || echo "  (일부 앱을 시작하지 못했습니다 — 앱 화면에서 확인하세요)" >&2
  fi
  # 예전 위치 정리 (복사가 끝난 원본)
  for d in "${olds[@]}"; do
    echo "▶ 예전 위치 정리: $d" >&2
    rm -rf --one-file-system "$d" || echo "  ($d 를 지우지 못했습니다 — 직접 지워도 됩니다)" >&2
  done
  rm -rf --one-file-system "$DATA"/.storage-mnt-* 2>/dev/null || true
  [[ -n "$cur" && $kind == projects ]] && rmdir "$cur" 2>/dev/null || true
  echo "✔ ${new:-$DATA (기본)}"
}

# ───────────────────────── main ─────────────────────────

main() {
cmd="${1:-}"; shift || true
case "$cmd" in
  prepare-app)
    valid_slug "${1:-}"
    install -d -o "$RUN_USER" -g "$RUN_USER" -m 0750 "$DATA/apps/$1/data"
    ;;
  install-unit) valid_slug "${1:-}"; install_unit "$1" ;;
  remove-unit)  valid_slug "${1:-}"; remove_unit "$1" ;;
  install-site) valid_slug "${1:-}"; install_site "$1" ;;
  remove-site)  valid_slug "${1:-}"; remove_site "$1" ;;
  svc)
    action="${1:-}"; valid_slug "${2:-}"
    [[ "$action" =~ ^(start|stop|restart)$ ]] || die "svc: action must be start|stop|restart"
    [[ -f "/etc/systemd/system/$(unit_name "$2")" ]] || die "unit not installed for $2"
    systemctl "$action" "$(unit_name "$2")"
    echo "$action $(unit_name "$2"): ok"
    ;;
  status)
    valid_slug "${1:-}"
    systemctl is-active "$(unit_name "$1")" 2>/dev/null || true
    ;;
  journal)
    valid_slug "${1:-}"; n="${2:-200}"
    [[ "$n" =~ ^[0-9]{1,4}$ ]] && (( n >= 1 && n <= 5000 )) || die "journal: lines must be 1..5000"
    journalctl -u "$(unit_name "$1")" -n "$n" --no-pager -o short-iso 2>/dev/null || true
    ;;
  install-cron) valid_slug "${1:-}"; valid_id "${2:-}"; install_cron "$1" "$2" ;;
  remove-cron)  valid_slug "${1:-}"; valid_id "${2:-}"; remove_cron "$1" "$2" ;;
  run-cron)
    valid_slug "${1:-}"; valid_id "${2:-}"
    [[ -f "/etc/systemd/system/$(cron_unit "$1" "$2").service" ]] || die "cron not installed"
    systemctl start --no-block "$(cron_unit "$1" "$2").service"; echo "started"
    ;;
  cron-status)
    valid_slug "${1:-}"; valid_id "${2:-}"
    systemctl show "$(cron_unit "$1" "$2").service" -p ActiveState -p Result -p ExecMainStatus -p ExecMainStartTimestamp -p ExecMainExitTimestamp 2>/dev/null || true
    systemctl show "$(cron_unit "$1" "$2").timer" -p NextElapseUSecRealtime -p LastTriggerUSec 2>/dev/null || true
    ;;
  cron-log)
    valid_slug "${1:-}"; valid_id "${2:-}"; n="${3:-100}"
    [[ "$n" =~ ^[0-9]{1,4}$ ]] && (( n >= 1 && n <= 5000 )) || die "lines must be 1..5000"
    journalctl -u "$(cron_unit "$1" "$2").service" -n "$n" --no-pager -o short-iso 2>/dev/null || true
    ;;
  db-create)   db_create "${1:-}" "${2:-}" ;;
  db-drop)     db_drop "${1:-}" "${2:-}" ;;
  db-password) db_password "${1:-}" "${2:-}" ;;
  db-user-create)   db_user_create "${1:-}" "${2:-}" "${3:-}" ;;
  db-user-drop)     db_user_drop "${1:-}" "${2:-}" ;;
  db-user-password) db_user_password "${1:-}" "${2:-}" ;;
  redis-user-set)   redis_user_set "${1:-}" "${2:-}" "${3:-}" ;;
  redis-user-drop)  redis_user_drop "${1:-}" ;;
  backup-db)   valid_backup_scope "${1:-}"; backup_db "$1" "${2:-}" "${3:-}" ;;
  backup-mongo)  valid_backup_scope "${1:-}"; backup_mongo "$1" "${2:-}" "${3:-}" ;;
  restore-mongo) valid_backup_scope "${1:-}"; restore_mongo "$1" "${2:-}" "${3:-}" ;;
  backup-data) valid_slug "${1:-}"; backup_data "$1" "${2:-}" ;;
  restore-db)  valid_backup_scope "${1:-}"; restore_db "$1" "${2:-}" "${3:-}" ;;
  restore-data) valid_slug "${1:-}"; restore_data "$1" "${2:-}" ;;
  nginx-log)   valid_slug "${1:-}"; nginx_log "$1" "${2:-}" "${3:-200}" ;;
  site-create)   valid_slug "${1:-}"; site_create "$1" "${2:-}" "${3:-}" "${4:-}" ;;
  site-password) valid_slug "${1:-}"; site_password "$1" ;;
  site-account-create)   valid_slug "${1:-}"; site_account_create "$1" "${2:-}" "${3:-}" ;;
  site-account-update)   valid_slug "${1:-}"; site_account_update "$1" "${2:-}" "${3:-}" "${4:-}" ;;
  site-account-password) valid_slug "${1:-}"; site_account_password "$1" "${2:-}" ;;
  site-account-keys)     valid_slug "${1:-}"; site_account_keys "$1" "${2:-}" ;;
  site-account-delete)   valid_slug "${1:-}"; site_account_delete "$1" "${2:-}" ;;
  ssl-issue)   valid_slug "${1:-}"; slug="$1"; shift; ssl_issue "$slug" "$@" ;;
  ssl-custom)  valid_slug "${1:-}"; ssl_custom "$1" ;;
  ssl-info)    valid_slug "${1:-}"; ssl_info "$1" ;;
  ssl-remove)  valid_slug "${1:-}"; ssl_remove "$1" ;;
  backup-files)  valid_slug "${1:-}"; backup_files "$1" "${2:-}" ;;
  restore-files) valid_slug "${1:-}"; restore_files "$1" "${2:-}" ;;
  system-log)
    # 패널·웹서버·SSH·DB 로그 (읽기 전용, 정해진 것만)
    n="${2:-200}"
    [[ "$n" =~ ^[0-9]{1,4}$ ]] && (( n >= 1 && n <= 5000 )) || die "system-log: lines must be 1..5000"
    case "${1:-}" in
      panel)   journalctl -u rpanel.service -n "$n" --no-pager -o short-iso 2>/dev/null || true ;;
      nginx)   tail -n "$n" /var/log/nginx/error.log 2>/dev/null || true ;;
      ssh)     journalctl -u ssh.service -u sshd.service -n "$n" --no-pager -o short-iso 2>/dev/null || true ;;
      mariadb) journalctl -u mariadb.service -n "$n" --no-pager -o short-iso 2>/dev/null || true ;;
      redis)   journalctl -u redis-server.service -n "$n" --no-pager -o short-iso 2>/dev/null || true ;;
      *) die "system-log: kind must be panel|nginx|ssh|mariadb|redis" ;;
    esac
    ;;
  system-events)
    # 대시보드 시스템 이벤트: 패널·nginx·DB·Redis·cron 기록과 모든 오류(priority ≤ 3) (읽기 전용)
    n="${1:-150}"
    [[ "$n" =~ ^[0-9]{1,4}$ ]] && (( n >= 1 && n <= 1000 )) || die "system-events: count must be 1..1000"
    journalctl -n "$n" -o json --no-pager \
      _SYSTEMD_UNIT=rpanel.service + _SYSTEMD_UNIT=nginx.service \
      + _SYSTEMD_UNIT=mariadb.service + _SYSTEMD_UNIT=mysql.service \
      + _SYSTEMD_UNIT=redis-server.service + _SYSTEMD_UNIT=redis.service \
      + _SYSTEMD_UNIT=cron.service + _SYSTEMD_UNIT=crond.service \
      + PRIORITY=0 + PRIORITY=1 + PRIORITY=2 + PRIORITY=3 2>/dev/null || true
    ;;
  runtime-install) runtime_install "${1:-}" "${2:-}" ;;
  panel-domain-set)    panel_domain_set "${1:-}" "${2:-}" ;;
  panel-domain-remove) panel_domain_remove ;;
  db-engine-upgrade)   db_engine_upgrade "${1:-}" "${2:-}" ;;
  db-engine-downgrade) db_engine_downgrade "${1:-}" "${2:-}" ;;
  panel-access)        panel_access "${1:-}" ;;
  runtime-remove)  runtime_remove "${1:-}" "${2:-}" ;;
  storage-set)     storage_set "${1:-}" "${2:-}" ;;
  purge-app)
    valid_slug "${1:-}"
    remove_all_crons "$1"
    remove_unit "$1"
    remove_site "$1"
    ssl_remove "$1" >/dev/null
    site_delete "$1"
    rm -rf --one-file-system "$DATA/apps/$1" "$DATA/www/$1" "$DATA/builds/$1"
    rm -f "$DATA/keys/$1" "$DATA/keys/$1.pub" "$STAGING/$1.service" "$STAGING/$1.conf" "$STAGING"/cron-"$1"-*
    # 백업 파일(/var/lib/rpanel/backups/<slug>)은 남겨 둡니다
    echo "purged $1"
    ;;
  *)
    die "usage: rpanel-helper {prepare-app|install-unit|remove-unit|install-site|remove-site|purge-app} <slug> | svc {start|stop|restart} <slug> | status|journal <slug> | {install,remove,run}-cron|cron-status|cron-log <slug> <id> | db-{create,drop,password} <db> <user> | db-user-create <db> <user> <all|read> (pw stdin) | db-user-drop <db> <user> | db-user-password <db> <user> (pw stdin) | redis-user-set <user> <pattern> <rw|ro> (pw stdin) | redis-user-drop <user> | backup-db <slug> <db> <stamp> | backup-data <slug> <stamp> | restore-db <slug> <db> <file> | restore-data <slug> <file> | nginx-log <slug> access|error <lines> | site-create <slug> <user> <domain> <static|rust|python|node|java> | site-password <slug> (stdin) | site-account-create <slug> <user> <ssh|sftp> (pw stdin) | site-account-update <slug> <user> <ssh|sftp> <on|off> | site-account-password <slug> <user> (stdin) | site-account-keys <slug> <user> (stdin) | site-account-delete <slug> <user> | ssl-issue <slug> <email> <domain>... | ssl-custom|ssl-info|ssl-remove <slug> | backup-files <slug> <stamp> | restore-files <slug> <file> | backup-mongo <slug> <db> <stamp> | restore-mongo <slug> <db> <file> | runtime-install|runtime-remove <python|node|java> <version> | system-log <panel|nginx|ssh|mariadb|redis> <lines> | system-events <count> | panel-domain-set <domain> <email> | panel-domain-remove | db-engine-upgrade|db-engine-downgrade <mariadb|mongodb|redis> <version> | panel-access <any|CIDR,...> | storage-set <backups|projects> <path|default>"
    ;;
esac
}

