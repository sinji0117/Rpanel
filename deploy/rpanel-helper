#!/bin/bash
# rpanel-helper — Rpanel 이 sudo 로 호출하는 유일한 root 권한 작업 스크립트.
#
#   설치: /usr/local/lib/rpanel/rpanel-helper  (root:root 0755)
#   sudoers: rpanel ALL=(root) NOPASSWD: /usr/local/lib/rpanel/rpanel-helper
#
# 패널(rpanel 사용자)이 탈취되더라도 이 스크립트가 허용하는 일만 할 수 있도록,
# 모든 인자와 스테이징 파일 내용을 화이트리스트로 검사합니다.
#   - systemd 유닛: rpanel-app 사용자로만 실행, 허용된 키만, 경로는 앱 디렉토리 안
#   - Nginx 사이트: 허용된 지시어만, root/로그/프록시 대상 경로 고정, 다른 사이트와 도메인 중복 금지
#   - 사이트 유저: rpanel-sites 그룹, /home/<user> 만, 레지스트리(/etc/rpanel/site-users)에 있는 것만 삭제
#   - PHP-FPM 풀: 레지스트리의 사이트 유저로만, 허용된 키만
#   - SSL: Let's Encrypt(webroot) / 사용자 인증서(키 일치 검사)
set -euo pipefail
umask 022
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C

DATA=/var/lib/rpanel
STAGING="$DATA/staging"
ACME_ROOT="$DATA/acme"
RUN_USER=rpanel-app
MARK="# managed by rpanel"
AVAIL=/etc/nginx/sites-available
ENABLED=/etc/nginx/sites-enabled

die() { echo "rpanel-helper: $*" >&2; exit 1; }

valid_slug() {
  [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]] || die "invalid slug: '${1:-}'"
}

unit_name() { echo "rpanel-app-$1.service"; }
site_name() { echo "rpanel-$1.conf"; }

staged_raw() {
  # 심볼릭 링크·다른 소유자 파일 거부
  local f="$1"
  [[ -f "$f" && ! -L "$f" ]] || die "staging file missing: $f"
  [[ "$(stat -c %U "$f")" == "rpanel" ]] || die "staging file not owned by rpanel: $f"
  local size; size=$(stat -c %s "$f")
  (( size < 65536 )) || die "staging file too large"
}

staged_file() {
  local f="$1"
  staged_raw "$f"
  head -n1 "$f" | grep -Eq "^[#;] managed by rpanel" || die "staging file is not rpanel-managed: $f"
  local size; size=$(stat -c %s "$f")
  (( size < 65536 )) || die "staging file too large"
}


# ───────────────────────── 사이트 유저 레지스트리 ─────────────────────────
# /etc/rpanel/site-users : "<slug> <user> <site_root>" 한 줄씩 (helper 만 수정)

SITES_REG="${RPANEL_TEST_SITES_REG:-/etc/rpanel/site-users}"   # 테스트용 덮어쓰기 (sudo env_reset 으로 운영에선 불가)
SITES_GROUP=rpanel-sites
RESERVED_USERS=" root daemon bin sys sync games man lp mail news uucp proxy www-data backup list irc nobody systemd-network systemd-resolve messagebus sshd syslog ubuntu admin administrator sysadmin mysql redis nginx rpanel rpanel-app postfix "

site_user_of() { [[ -f $SITES_REG ]] && awk -v s="$1" '$1==s {print $2; exit}' "$SITES_REG" || true; }
site_root_of() { [[ -f $SITES_REG ]] && awk -v s="$1" '$1==s {print $3; exit}' "$SITES_REG" || true; }

valid_site_user() {
  local u="${1:-}"
  [[ "$u" =~ ^[a-z][a-z0-9-]{2,31}$ ]] || die "invalid site user: '$u' (소문자로 시작, 소문자·숫자·- 3~32자)"
  [[ "$RESERVED_USERS" != *" $u "* ]] || die "reserved user name: $u"
}

valid_domain() {
  local d="${1:-}"
  [[ ${#d} -le 253 && "$d" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] || die "invalid domain: '$d'"
}

registered_site_user() {
  local u="$1"
  [[ -f $SITES_REG ]] && awk -v u="$u" '$2==u {f=1} END {exit !f}' "$SITES_REG"
}

# ───────────────────────── systemd ─────────────────────────

validate_unit() {
  local f="$1" slug="$2" appdir="$DATA/apps/$2" mode="${3:-service}"
  local line key val section=""
  local saw_user=0 saw_nnp=0
  # 실행 사용자·경로: 파일 기반 사이트면 사이트 유저, 아니면 rpanel-app
  local run_user="$RUN_USER" cwd="$appdir/current" rw="$appdir/data" suser sroot
  suser="$(site_user_of "$slug")"; sroot="$(site_root_of "$slug")"
  if [[ -n "$suser" ]]; then run_user="$suser"; cwd="$sroot"; rw="/home/$suser"; fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" =~ ^\[(Unit|Service|Install)\]$ ]]; then section="${BASH_REMATCH[1]}"; continue; fi
    [[ "$line" =~ ^([A-Za-z]+)=(.*)$ ]] || die "unit: bad line: $line"
    key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
    case "$section:$key" in
      Unit:Description|Unit:After|Unit:Wants) ;;
      Service:Type)
        if [[ "$mode" == cron ]]; then [[ "$val" == oneshot ]] || die "unit: cron Type must be oneshot"
        else [[ "$val" == simple ]] || die "unit: Type must be simple"; fi ;;
      Service:TimeoutStartSec) [[ "$mode" == cron && "$val" =~ ^[0-9]{1,6}$ ]] || die "unit: TimeoutStartSec only for cron" ;;
      Service:User|Service:Group) [[ "$val" == "$run_user" ]] || die "unit: $key must be $run_user"; saw_user=1 ;;
      Service:WorkingDirectory) [[ "$val" == "$cwd" ]] || die "unit: bad WorkingDirectory" ;;
      Service:EnvironmentFile) [[ "$val" == "$appdir/app.env" ]] || die "unit: bad EnvironmentFile" ;;
      Service:ReadWritePaths) [[ "$val" == "$rw" ]] || die "unit: bad ReadWritePaths" ;;
      Service:Environment) [[ "$val" =~ ^PATH=[A-Za-z0-9/:._-]+$ ]] || die "unit: only PATH= Environment allowed" ;;
      Service:ExecStart)
        if [[ "$val" == /bin/bash\ -c\ * ]]; then :
        elif [[ -z "$suser" && "$val" =~ ^"$appdir/current/"[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]]; then :
        else die "unit: ExecStart must be the app binary or /bin/bash -c"; fi ;;
      Service:NoNewPrivileges) [[ "$val" == true ]] || die "unit: NoNewPrivileges must be true"; saw_nnp=1 ;;
      Service:Restart|Service:RestartSec)
        [[ "$mode" == service ]] || die "unit: $key not allowed for cron" ;;
      Service:ProtectHome) [[ -z "$suser" ]] || die "unit: ProtectHome not allowed for site users" ;;
      Service:TimeoutStopSec|Service:PrivateTmp|Service:PrivateDevices|\
      Service:ProtectSystem|Service:ProtectKernelTunables|Service:ProtectKernelModules|\
      Service:ProtectControlGroups|Service:RestrictAddressFamilies|Service:RestrictNamespaces|\
      Service:LockPersonality|Service:MemoryDenyWriteExecute|Service:LimitNOFILE) ;;
      Install:WantedBy) [[ "$mode" == service && "$val" == multi-user.target ]] || die "unit: bad WantedBy" ;;
      *) die "unit: key not allowed: [$section] $key" ;;
    esac
  done < "$f"
  (( saw_user && saw_nnp )) || die "unit: User=$run_user and NoNewPrivileges=true are required"
}

install_unit() {
  local slug="$1" src="$STAGING/$1.service" dst
  staged_file "$src"
  validate_unit "$src" "$slug"
  dst="/etc/systemd/system/$(unit_name "$slug")"
  install -m 0644 -o root -g root "$src" "$dst"
  systemctl daemon-reload
  systemctl enable "$(unit_name "$slug")" >/dev/null 2>&1
  echo "installed $dst"
}

remove_unit() {
  local u; u="$(unit_name "$1")"
  if [[ -f "/etc/systemd/system/$u" ]]; then
    systemctl disable --now "$u" >/dev/null 2>&1 || true
    rm -f "/etc/systemd/system/$u"
    systemctl daemon-reload
    echo "removed $u"
  fi
}

# ───────────────────────── nginx ─────────────────────────

validate_site() {
  local f="$1" slug="$2" line d
  local www="$DATA/www/$slug/current" sroot suser
  sroot="$(site_root_of "$slug")"; suser="$(site_user_of "$slug")"
  local in_gzip_types=0 re
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"   # ltrim
    [[ -z "$line" || "$line" == \#* || "$line" == "}" ]] && continue
    if (( in_gzip_types )); then
      re='^[a-z0-9/+. -]+;?$'
      [[ "$line" =~ $re ]] || die "site: bad gzip_types continuation"
      [[ "$line" == *\; ]] && in_gzip_types=0
      continue
    fi
    d="${line%%[[:space:]]*}"
    case "$d" in
      try_files|proxy_set_header|location|fastcgi_param|fastcgi_split_path_info|return) ;;
      *) [[ "$line" == *'$'* || "$line" == *'\'* || "$line" == *'`'* ]] && die "site: unexpected characters: $line" ;;
    esac
    [[ "$line" == *'`'* ]] && die "site: unexpected characters: $line"
    case "$d" in
      server) [[ "$line" == "server {" ]] || die "site: bad server line" ;;
      listen)
        [[ "$line" == "listen 80;" || "$line" == "listen [::]:80;" || "$line" == "listen 443 ssl http2;" || "$line" == "listen [::]:443 ssl http2;" ]] \
          || die "site: listen not allowed: $line" ;;
      server_name) [[ "$line" =~ ^server_name(\ [a-z0-9.-]+)+\;$ ]] || die "site: bad server_name" ;;
      set_real_ip_from) [[ "$line" =~ ^set_real_ip_from\ [0-9a-f.:/]+\;$ ]] || die "site: bad set_real_ip_from" ;;
      ssl_certificate|ssl_certificate_key)
        [[ "$line" == "ssl_certificate /etc/letsencrypt/live/rpanel-$slug/fullchain.pem;" || \
           "$line" == "ssl_certificate_key /etc/letsencrypt/live/rpanel-$slug/privkey.pem;" || \
           "$line" == "ssl_certificate /etc/rpanel/certs/$slug/fullchain.pem;" || \
           "$line" == "ssl_certificate_key /etc/rpanel/certs/$slug/key.pem;" ]] || die "site: bad certificate path" ;;
      ssl_protocols) [[ "$line" == "ssl_protocols TLSv1.2 TLSv1.3;" ]] || die "site: bad ssl_protocols" ;;
      ssl_session_cache) [[ "$line" == "ssl_session_cache shared:rpanel_ssl:10m;" ]] || die "site: bad ssl_session_cache" ;;
      ssl_session_timeout) [[ "$line" == "ssl_session_timeout 1d;" ]] || die "site: bad ssl_session_timeout" ;;
      return) [[ "$line" == 'return 301 https://$host$request_uri;' ]] || die "site: return not allowed: $line" ;;
      real_ip_header|real_ip_recursive|index|expires|gzip|gzip_vary|gzip_min_length|default_type|\
      proxy_http_version|proxy_connect_timeout|proxy_read_timeout|proxy_send_timeout|proxy_buffering|add_header|proxy_set_header|try_files)
        [[ "$line" == *\; ]] || die "site: missing ';' in $d" ;;
      client_max_body_size) [[ "$line" =~ ^client_max_body_size\ [0-9]{1,5}m\;$ ]] || die "site: bad client_max_body_size" ;;
      proxy_ssl_server_name) [[ "$line" == "proxy_ssl_server_name on;" ]] || die "site: bad proxy_ssl_server_name" ;;
      deny) [[ "$line" == "deny all;" ]] || die "site: bad deny" ;;
      gzip_types) [[ "$line" == *\; ]] || in_gzip_types=1 ;;
      access_log|error_log)
        [[ "$line" =~ ^(access|error)_log\ +(/var/log/nginx/rpanel-$slug-(access|error)\.log|off)\;$ ]] || die "site: bad log path" ;;
      root)
        if [[ "$line" == "root $www;" || "$line" == "root $ACME_ROOT;" ]]; then :
        elif [[ -n "$sroot" && ( "$line" == "root $sroot;" || "$line" =~ ^root\ "$sroot"/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*\;$ ) && "$line" != *..* ]]; then :
        else die "site: root not allowed: $line"; fi ;;
      proxy_pass)
        re='^proxy_pass https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?;$'
        [[ "$line" =~ $re ]] || die "site: bad proxy_pass" ;;
      fastcgi_pass) [[ -n "$suser" && "$line" == "fastcgi_pass unix:/run/php/rpanel-$slug.sock;" ]] || die "site: bad fastcgi_pass" ;;
      fastcgi_index) [[ "$line" == "fastcgi_index index.php;" ]] || die "site: bad fastcgi_index" ;;
      fastcgi_read_timeout) [[ "$line" =~ ^fastcgi_read_timeout\ [0-9]{1,5}s\;$ ]] || die "site: bad fastcgi_read_timeout" ;;
      fastcgi_split_path_info) [[ "$line" == 'fastcgi_split_path_info ^(.+\.php)(/.+)$;' ]] || die "site: bad fastcgi_split_path_info" ;;
      fastcgi_param)
        [[ "$line" == 'fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;' || \
           "$line" == 'fastcgi_param HTTPS $rpanel_https if_not_empty;' ]] || die "site: fastcgi_param not allowed: $line" ;;
      include) [[ "$line" == "include fastcgi_params;" ]] || die "site: include not allowed" ;;
      location)
        [[ "$line" == "location / {" || "$line" == "location /api/ {" || "$line" == "location = /index.html {" || \
           "$line" == "location ^~ /.well-known/acme-challenge/ {" || "$line" == 'location ~ \.php$ {' || \
           "$line" == 'location ~ /\.(?!well-known).* {' || \
           "$line" == 'location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|avif|ico)$ {' ]] || die "site: location not allowed: $line" ;;
      *) die "site: directive not allowed: $d" ;;
    esac
  done < "$f"
}

check_domain_conflicts() {
  local src="$1" slug="$2" own names n f target
  own="$AVAIL/$(site_name "$slug")"
  names=$(grep -Po '^\s*server_name\s+\K[^;]+' "$src" || true)
  for n in $names; do
    for f in "$ENABLED"/*; do
      [[ -e "$f" ]] || continue
      target=$(readlink -f "$f")
      [[ "$target" == "$own" ]] && continue
      if grep -Eq "^[[:space:]]*server_name[^;]*[[:space:]]${n//./\\.}([[:space:];]|$)" "$target"; then
        die "domain '$n' is already served by $target — 다른 Nginx 설정과 겹칩니다. 기존 파일을 정리하거나 다른 도메인을 쓰세요"
      fi
    done
  done
}

install_site() {
  local slug="$1" src="$STAGING/$1.conf" dst link backup=""
  staged_file "$src"
  validate_site "$src" "$slug"
  check_domain_conflicts "$src" "$slug"
  dst="$AVAIL/$(site_name "$slug")"
  link="$ENABLED/$(site_name "$slug")"
  if [[ -f "$dst" ]]; then backup=$(mktemp); cp -p "$dst" "$backup"; fi
  install -m 0644 -o root -g root "$src" "$dst"
  ln -sfn "$dst" "$link"
  if ! nginx -t 2>/tmp/rpanel-nginx-test.$$; then
    cat /tmp/rpanel-nginx-test.$$ >&2; rm -f /tmp/rpanel-nginx-test.$$
    if [[ -n "$backup" ]]; then mv "$backup" "$dst"; else rm -f "$dst" "$link"; fi
    die "nginx -t failed — 이전 설정으로 되돌렸습니다"
  fi
  rm -f /tmp/rpanel-nginx-test.$$ "${backup:-/nonexistent}"
  systemctl reload nginx
  echo "installed $dst (nginx reloaded)"
}

remove_site() {
  local slug="$1" dst link
  dst="$AVAIL/$(site_name "$slug")"; link="$ENABLED/$(site_name "$slug")"
  if [[ -e "$dst" || -L "$link" ]]; then
    rm -f "$link" "$dst"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
    echo "removed $dst"
  fi
}


# ───────────────────────── cron (systemd timer) ─────────────────────────

cron_unit() { echo "rpanel-cron-$1-$2"; }
valid_id() { [[ "${1:-}" =~ ^[0-9]{1,10}$ ]] || die "invalid id: '${1:-}'"; }

valid_calendar() {
  local expr="$1" re='^[A-Za-z0-9*:/,. ~-]+$'
  [[ ${#expr} -le 100 && "$expr" =~ $re ]] || die "timer: bad OnCalendar"
  if command -v systemd-analyze >/dev/null 2>&1; then
    systemd-analyze calendar "$expr" >/dev/null 2>&1 || die "timer: systemd가 해석할 수 없는 일정입니다: $expr"
  fi
}

validate_timer() {
  local f="$1" slug="$2" id="$3" line key val section="" saw_cal=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    if [[ "$line" =~ ^\[(Unit|Timer|Install)\]$ ]]; then section="${BASH_REMATCH[1]}"; continue; fi
    [[ "$line" =~ ^([A-Za-z]+)=(.*)$ ]] || die "timer: bad line: $line"
    key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
    case "$section:$key" in
      Unit:Description) ;;
      Timer:OnCalendar) valid_calendar "$val"; saw_cal=1 ;;
      Timer:Persistent) [[ "$val" == true || "$val" == false ]] || die "timer: bad Persistent" ;;
      Timer:Unit) [[ "$val" == "$(cron_unit "$slug" "$id").service" ]] || die "timer: bad Unit" ;;
      Install:WantedBy) [[ "$val" == timers.target ]] || die "timer: bad WantedBy" ;;
      *) die "timer: key not allowed: [$section] $key" ;;
    esac
  done < "$f"
  (( saw_cal )) || die "timer: OnCalendar required"
}

install_cron() {
  local slug="$1" id="$2" svc="$STAGING/cron-$1-$2.service" tmr="$STAGING/cron-$1-$2.timer" u
  staged_file "$svc"; staged_file "$tmr"
  validate_unit "$svc" "$slug" cron
  validate_timer "$tmr" "$slug" "$id"
  u="$(cron_unit "$slug" "$id")"
  install -m 0644 -o root -g root "$svc" "/etc/systemd/system/$u.service"
  install -m 0644 -o root -g root "$tmr" "/etc/systemd/system/$u.timer"
  systemctl daemon-reload
  systemctl enable --now "$u.timer" >/dev/null 2>&1
  echo "installed $u.timer"
}

remove_cron() {
  local u; u="$(cron_unit "$1" "$2")"
  systemctl disable --now "$u.timer" >/dev/null 2>&1 || true
  systemctl stop "$u.service" >/dev/null 2>&1 || true
  rm -f "/etc/systemd/system/$u.timer" "/etc/systemd/system/$u.service"
  systemctl daemon-reload
  echo "removed $u"
}

remove_all_crons() {
  local f u
  for f in /etc/systemd/system/rpanel-cron-"$1"-*.timer; do
    [[ -e "$f" ]] || continue
    u="$(basename "$f" .timer)"
    [[ "$u" =~ ^rpanel-cron-$1-[0-9]+$ ]] || continue
    remove_cron "$1" "${u##*-}"
  done
}

# ───────────────────────── MariaDB ─────────────────────────

REGISTRY=/etc/rpanel/managed-dbs
RESERVED_DB=" mysql information_schema performance_schema sys test root rpanel mariadb.sys "

valid_db_ident() {
  local v="${1:-}" max="$2"
  [[ "$v" =~ ^[a-z][a-z0-9_]+$ && ${#v} -le $max ]] || die "invalid identifier: '$v'"
  [[ "$RESERVED_DB" != *" $v "* ]] || die "reserved name: $v"
}

registered() { [[ -f $REGISTRY ]] && grep -qx "$1 $2" "$REGISTRY"; }
registered_db() { [[ -f $REGISTRY ]] && grep -q "^$1 " "$REGISTRY"; }
sql() { mariadb --batch --skip-column-names -e "$1"; }

db_create() {
  local name="$1" user="$2" pw
  valid_db_ident "$name" 64; valid_db_ident "$user" 32
  [[ -z "$(sql "SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='$name'")" ]] \
    || die "데이터베이스 $name 이(가) 이미 있습니다 (패널은 기존 DB를 가져오지 않습니다)"
  [[ -z "$(sql "SELECT User FROM mysql.user WHERE User='$user'")" ]] || die "사용자 $user 이(가) 이미 있습니다"
  pw="$(openssl rand -hex 24)"
  sql "CREATE DATABASE \`$name\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
       CREATE USER '$user'@'localhost' IDENTIFIED BY '$pw';
       GRANT ALL PRIVILEGES ON \`$name\`.* TO '$user'@'localhost';
       FLUSH PRIVILEGES;"
  install -d -m 0750 -o root -g root /etc/rpanel
  touch "$REGISTRY"; chmod 0600 "$REGISTRY"
  echo "$name $user" >> "$REGISTRY"
  echo "$pw"
}

db_drop() {
  local name="$1" user="$2"
  valid_db_ident "$name" 64; valid_db_ident "$user" 32
  registered "$name" "$user" || die "패널이 만든 DB가 아닙니다: $name"
  sql "DROP DATABASE IF EXISTS \`$name\`; DROP USER IF EXISTS '$user'@'localhost'; FLUSH PRIVILEGES;"
  grep -vx "$name $user" "$REGISTRY" > "$REGISTRY.tmp" || true
  mv "$REGISTRY.tmp" "$REGISTRY"; chmod 0600 "$REGISTRY"
  echo "dropped $name"
}

db_password() {
  local name="$1" user="$2" pw
  valid_db_ident "$name" 64; valid_db_ident "$user" 32
  registered "$name" "$user" || die "패널이 만든 DB가 아닙니다: $name"
  pw="$(openssl rand -hex 24)"
  sql "ALTER USER '$user'@'localhost' IDENTIFIED BY '$pw'; FLUSH PRIVILEGES;"
  echo "$pw"
}

# ───────────────────────── 백업 ─────────────────────────

BACKUPS="$DATA/backups"
valid_stamp() { [[ "${1:-}" =~ ^[0-9]{8}-[0-9]{6}$ ]] || die "invalid stamp"; }
valid_backup_file() { [[ "${1:-}" =~ ^[0-9]{8}-[0-9]{6}-(db-[a-z][a-z0-9_]+\.sql|data\.tar|files\.tar)\.gz$ ]] || die "invalid backup file name"; }

backup_dir() {
  install -d -o rpanel -g rpanel -m 0750 "$BACKUPS" "$BACKUPS/$1"
  echo "$BACKUPS/$1"
}

finish_file() { chown rpanel:rpanel "$1"; chmod 0640 "$1"; stat -c %s "$1"; }

backup_db() {
  local slug="$1" name="$2" stamp="$3" dir out
  valid_db_ident "$name" 64; valid_stamp "$stamp"
  registered_db "$name" || die "패널이 만든 DB가 아닙니다: $name"
  dir="$(backup_dir "$slug")"; out="$dir/$stamp-db-$name.sql.gz"
  set -o pipefail
  mariadb-dump --single-transaction --quick --routines --triggers --events "$name" | gzip -6 > "$out.part" \
    || { rm -f "$out.part"; die "mariadb-dump 실패"; }
  mv "$out.part" "$out"
  finish_file "$out"
}

backup_data() {
  local slug="$1" stamp="$2" dir out
  valid_stamp "$stamp"
  dir="$(backup_dir "$slug")"; out="$dir/$stamp-data.tar.gz"
  install -d -o "$RUN_USER" -g "$RUN_USER" -m 0750 "$DATA/apps/$slug/data"
  tar -C "$DATA/apps/$slug" -czf "$out.part" data || { rm -f "$out.part"; die "tar 실패"; }
  mv "$out.part" "$out"
  finish_file "$out"
}

restore_db() {
  local slug="$1" name="$2" file="$3" path
  valid_db_ident "$name" 64; valid_backup_file "$file"
  [[ "$file" == *-db-"$name".sql.gz ]] || die "다른 DB의 백업입니다"
  registered_db "$name" || die "패널이 만든 DB가 아닙니다: $name"
  path="$BACKUPS/$slug/$file"; [[ -f "$path" && ! -L "$path" ]] || die "백업 파일이 없습니다"
  set -o pipefail
  gunzip -c "$path" | mariadb "$name" || die "복원 실패"
  echo "restored $name from $file"
}

restore_data() {
  local slug="$1" file="$2" path unit was_active=0 app="$DATA/apps/$1"
  valid_backup_file "$file"; [[ "$file" == *-data.tar.gz ]] || die "data 백업이 아닙니다"
  path="$BACKUPS/$slug/$file"; [[ -f "$path" && ! -L "$path" ]] || die "백업 파일이 없습니다"
  # 아카이브 안 경로 검사: data/ 아래만, 절대경로·.. 금지
  if tar -tzf "$path" | grep -Ev '^data(/|$)' | grep -q . ; then die "아카이브에 허용되지 않은 경로가 있습니다"; fi
  if tar -tzf "$path" | grep -Eq '(^|/)\.\.(/|$)'; then die "아카이브에 .. 경로가 있습니다"; fi
  if tar -tvzf "$path" | grep -Eq '^[lhbcp]| link to '; then die "아카이브에 링크·특수 파일이 있습니다"; fi
  unit="$(unit_name "$slug")"
  if systemctl is-active --quiet "$unit" 2>/dev/null; then was_active=1; systemctl stop "$unit"; fi
  rm -rf --one-file-system "$app/data"
  install -d -m 0750 "$app"
  tar -C "$app" --no-same-owner --no-same-permissions -xzf "$path"
  chown -R "$RUN_USER:$RUN_USER" "$app/data"; chmod 0750 "$app/data"
  (( was_active )) && systemctl start "$unit"
  echo "restored data from $file"
}


# ───────────────────────── 사이트 유저 · 파일 사이트 ─────────────────────────

site_create() {
  local slug="$1" user="$2" domain="$3" kind="$4" home root
  valid_site_user "$user"; valid_domain "$domain"
  [[ "$kind" =~ ^(static|php|node)$ ]] || die "invalid kind"
  [[ -z "$(site_user_of "$slug")" ]] || die "이미 사이트 유저가 있는 앱입니다: $slug"
  id "$user" >/dev/null 2>&1 && die "시스템에 이미 있는 사용자입니다: $user"
  getent group "$SITES_GROUP" >/dev/null || groupadd --system "$SITES_GROUP"
  home="/home/$user"; root="$home/htdocs/$domain"
  [[ ! -e "$home" ]] || die "$home 이(가) 이미 있습니다"
  useradd --create-home --home-dir "$home" --shell /bin/bash --user-group --groups "$SITES_GROUP" "$user"
  chmod 0750 "$home"
  # Nginx(www-data) 가 정적 파일을 읽도록 사이트 그룹에 추가
  usermod -aG "$user" www-data
  install -d -o "$user" -g "$user" -m 0750 "$home/htdocs" "$root"
  install -d -o "$user" -g "$user" -m 0750 "$home/logs"
  install -d -o "$user" -g "$user" -m 0700 "$home/.ssh"
  install -m 0600 -o "$user" -g "$user" /dev/null "$home/.ssh/authorized_keys"
  case "$kind" in
    php)
      cat > "$root/index.php" <<EOF
<?php
// $domain — Rpanel 로 만든 PHP 사이트. 이 파일을 지우고 사이트 파일을 올리세요.
echo '<h1>$domain</h1><p>PHP ' . PHP_VERSION . ' 동작 중</p>';
EOF
      ;;
    static)
      cat > "$root/index.html" <<EOF
<!doctype html><html lang="ko"><meta charset="utf-8"><title>$domain</title>
<body style="font-family:sans-serif;padding:4rem"><h1>$domain</h1><p>Rpanel 로 만든 사이트입니다. 이 파일을 지우고 사이트 파일을 올리세요.</p></body></html>
EOF
      ;;
    node)
      cat > "$root/server.js" <<'EOF'
// Rpanel 로 만든 Node.js 사이트 예시 — PORT 환경변수로 받은 포트에서 실행하세요.
const http = require('http');
const port = process.env.PORT || 3000;
http.createServer((req, res) => {
  res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
  res.end('<h1>Node.js ' + process.version + ' 동작 중</h1>');
}).listen(port, '127.0.0.1', () => console.log('listening on ' + port));
EOF
      ;;
  esac
  chown -R "$user:$user" "$root"
  install -d -m 0750 -o root -g rpanel /etc/rpanel
  touch "$SITES_REG"; chmod 0644 "$SITES_REG"
  echo "$slug $user $root" >> "$SITES_REG"
  systemctl reload nginx 2>/dev/null || true   # www-data 그룹 변경 반영
  echo "$root"
}

site_password() {
  local slug="$1" user pw
  user="$(site_user_of "$slug")"; [[ -n "$user" ]] || die "사이트 유저가 없는 앱입니다: $slug"
  IFS= read -r pw || true
  [[ ${#pw} -ge 10 && ${#pw} -le 128 ]] || die "비밀번호는 10~128자여야 합니다"
  [[ "$pw" != *:* ]] || die "비밀번호에 ':' 를 쓸 수 없습니다"
  printf '%s:%s\n' "$user" "$pw" | chpasswd
  echo "password updated for $user"
}

site_delete() {
  local slug="$1" user
  user="$(site_user_of "$slug")"
  [[ -n "$user" ]] || return 0
  valid_site_user "$user"
  id -nG "$user" 2>/dev/null | tr ' ' '\n' | grep -qx "$SITES_GROUP" || die "$user 는 rpanel 사이트 유저가 아닙니다"
  remove_php_pools "$slug"
  pkill -u "$user" 2>/dev/null || true
  sleep 0.5
  gpasswd -d www-data "$user" >/dev/null 2>&1 || true
  userdel --remove "$user" 2>/dev/null || userdel "$user"
  rm -rf --one-file-system "/home/$user"
  awk -v s="$slug" '$1!=s' "$SITES_REG" > "$SITES_REG.tmp"; mv "$SITES_REG.tmp" "$SITES_REG"; chmod 0644 "$SITES_REG"
  echo "deleted site user $user"
}

# ───────────────────────── PHP-FPM ─────────────────────────

valid_php_version() {
  [[ "${1:-}" =~ ^(5\.6|7\.[0-4]|8\.[0-9])$ ]] || die "invalid php version: '${1:-}'"
  [[ -d "/etc/php/$1/fpm/pool.d" ]] || die "PHP $1 FPM 이 설치되어 있지 않습니다 (설치: install.sh --php=$1)"
}

validate_pool() {
  local f="$1" slug="$2" user="$3" line key val
  local line_re='^([a-z_.]+(\[[A-Za-z_.][A-Za-z0-9_.]*\])?) = (.*)$'
  local env_key_re='^env\[[A-Za-z_][A-Za-z0-9_]*\]$'
  local env_val_re='^"[^"\\$`]*"$'
  local seen_section=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \;* ]] && continue
    if [[ "$line" == "[rpanel-$slug]" ]]; then seen_section=1; continue; fi
    (( seen_section )) || die "pool: section [rpanel-$slug] must come first"
    [[ "$line" =~ $line_re ]] || die "pool: bad line: $line"
    key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[3]}"
    case "$key" in
      user|group) [[ "$val" == "$user" ]] || die "pool: $key must be $user" ;;
      listen) [[ "$val" == "/run/php/rpanel-$slug.sock" ]] || die "pool: bad listen" ;;
      listen.owner|listen.group) [[ "$val" == www-data ]] || die "pool: bad $key" ;;
      listen.mode) [[ "$val" == 0660 ]] || die "pool: bad listen.mode" ;;
      pm) [[ "$val" == ondemand || "$val" == dynamic ]] || die "pool: bad pm" ;;
      pm.max_children|pm.max_requests|pm.start_servers|pm.min_spare_servers|pm.max_spare_servers)
        [[ "$val" =~ ^[0-9]{1,4}$ ]] || die "pool: bad $key" ;;
      pm.process_idle_timeout) [[ "$val" =~ ^[0-9]{1,4}s$ ]] || die "pool: bad $key" ;;
      'php_admin_value[memory_limit]'|'php_admin_value[upload_max_filesize]'|'php_admin_value[post_max_size]')
        [[ "$val" =~ ^[0-9]{1,5}M$ ]] || die "pool: bad $key" ;;
      'php_admin_value[max_execution_time]'|'php_admin_value[max_input_time]')
        [[ "$val" =~ ^[0-9]{1,5}$ ]] || die "pool: bad $key" ;;
      'php_admin_flag[log_errors]') [[ "$val" == on || "$val" == off ]] || die "pool: bad $key" ;;
      'php_admin_value[error_log]') [[ "$val" == "/home/$user/logs/php-error.log" ]] || die "pool: bad error_log" ;;
      env\[*\])
        [[ "$key" =~ $env_key_re ]] || die "pool: bad env key"
        [[ "$val" =~ $env_val_re ]] || die "pool: bad env value for $key" ;;
      *) die "pool: key not allowed: $key" ;;
    esac
  done < "$f"
}

remove_php_pools() {
  local slug="$1" f v
  for f in /etc/php/*/fpm/pool.d/rpanel-"$slug".conf; do
    [[ -e "$f" ]] || continue
    v="$(echo "$f" | cut -d/ -f4)"
    rm -f "$f"
    systemctl reload "php$v-fpm" 2>/dev/null || systemctl restart "php$v-fpm" 2>/dev/null || true
  done
}

install_php_pool() {
  local slug="$1" version="$2" src="$STAGING/$1.php.conf" user dst backup="" f v
  valid_php_version "$version"
  user="$(site_user_of "$slug")"; [[ -n "$user" ]] || die "사이트 유저가 없는 앱입니다: $slug"
  staged_file "$src"
  validate_pool "$src" "$slug" "$user"
  # 다른 버전에 있던 풀은 제거 (버전 변경)
  for f in /etc/php/*/fpm/pool.d/rpanel-"$slug".conf; do
    [[ -e "$f" ]] || continue
    v="$(echo "$f" | cut -d/ -f4)"
    [[ "$v" == "$version" ]] && continue
    rm -f "$f"; systemctl reload "php$v-fpm" 2>/dev/null || true
  done
  dst="/etc/php/$version/fpm/pool.d/rpanel-$slug.conf"
  if [[ -f "$dst" ]]; then backup=$(mktemp); cp -p "$dst" "$backup"; fi
  install -m 0644 -o root -g root "$src" "$dst"
  if ! "php-fpm$version" -t >/tmp/rpanel-fpm-test.$$ 2>&1; then
    cat /tmp/rpanel-fpm-test.$$ >&2; rm -f /tmp/rpanel-fpm-test.$$
    if [[ -n "$backup" ]]; then mv "$backup" "$dst"; else rm -f "$dst"; fi
    die "php-fpm$version -t 실패 — 이전 설정으로 되돌렸습니다"
  fi
  rm -f /tmp/rpanel-fpm-test.$$ "${backup:-/nonexistent}"
  systemctl enable "php$version-fpm" >/dev/null 2>&1 || true
  if systemctl is-active --quiet "php$version-fpm"; then systemctl reload "php$version-fpm"; else systemctl start "php$version-fpm"; fi
  for _ in $(seq 1 20); do [[ -S "/run/php/rpanel-$slug.sock" ]] && break; sleep 0.25; done
  [[ -S "/run/php/rpanel-$slug.sock" ]] || die "PHP-FPM 소켓이 만들어지지 않았습니다: journalctl -u php$version-fpm"
  echo "installed $dst (php$version-fpm reloaded)"
}

php_versions() {
  local d
  for d in /etc/php/*/fpm/pool.d; do
    [[ -d "$d" ]] && echo "$d" | cut -d/ -f4
  done | sort -V
}

# ───────────────────────── SSL ─────────────────────────

valid_email() {
  [[ ${#1} -le 190 && "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "invalid email: '$1'"
}

ssl_issue() {
  local slug="$1" email="$2"; shift 2
  valid_email "$email"
  (( $# >= 1 && $# <= 20 )) || die "도메인이 필요합니다"
  local args=() d
  for d in "$@"; do valid_domain "$d"; args+=(-d "$d"); done
  command -v certbot >/dev/null || die "certbot 이 설치되어 있지 않습니다 (apt install certbot)"
  install -d -m 0755 "$ACME_ROOT"
  certbot certonly --webroot -w "$ACME_ROOT" --cert-name "rpanel-$slug" \
    --non-interactive --agree-tos -m "$email" --keep-until-expiring --expand "${args[@]}" 2>&1 \
    || die "Let's Encrypt 발급 실패 — 도메인 DNS 가 이 서버를 가리키는지, 80 포트가 열려 있는지 확인하세요"
  echo "issued rpanel-$slug"
}

ssl_custom() {
  local slug="$1" crt="$STAGING/$1.crt" key="$STAGING/$1.key" dir="/etc/rpanel/certs/$1"
  staged_raw "$crt"; staged_raw "$key"
  openssl x509 -in "$crt" -noout >/dev/null 2>&1 || { rm -f "$crt" "$key"; die "인증서(PEM)를 읽을 수 없습니다"; }
  openssl pkey -in "$key" -noout >/dev/null 2>&1 || { rm -f "$crt" "$key"; die "개인키(PEM)를 읽을 수 없습니다 (암호가 걸린 키는 지원하지 않습니다)"; }
  if [[ "$(openssl x509 -in "$crt" -noout -pubkey | openssl sha256)" != "$(openssl pkey -in "$key" -pubout | openssl sha256)" ]]; then
    rm -f "$crt" "$key"; die "인증서와 개인키가 서로 맞지 않습니다"
  fi
  install -d -m 0700 -o root -g root "$dir"
  install -m 0644 -o root -g root "$crt" "$dir/fullchain.pem"
  install -m 0600 -o root -g root "$key" "$dir/key.pem"
  rm -f "$crt" "$key"
  echo "installed custom certificate for $slug"
}

ssl_info() {
  local slug="$1" f
  for f in "/etc/letsencrypt/live/rpanel-$slug/fullchain.pem" "/etc/rpanel/certs/$slug/fullchain.pem"; do
    [[ -f "$f" ]] || continue
    echo "path=$f"
    openssl x509 -in "$f" -noout -enddate -issuer -subject 2>/dev/null | sed -E 's/^notAfter=/not_after=/; s/^issuer=/issuer=/; s/^subject=/subject=/'
    openssl x509 -in "$f" -noout -ext subjectAltName 2>/dev/null | tail -n +2 | tr -d ' ' | sed 's/^/san=/'
  done
}

ssl_remove() {
  local slug="$1"
  if command -v certbot >/dev/null && [[ -d "/etc/letsencrypt/live/rpanel-$slug" ]]; then
    certbot delete --cert-name "rpanel-$slug" --non-interactive >/dev/null 2>&1 || true
  fi
  rm -rf "/etc/rpanel/certs/$slug"
  echo "removed certificates for $slug"
}

# ───────────────────────── 파일 사이트 백업 ─────────────────────────

backup_files() {
  local slug="$1" stamp="$2" dir out user
  valid_stamp "$stamp"
  user="$(site_user_of "$slug")"; [[ -n "$user" ]] || die "사이트 유저가 없는 앱입니다"
  dir="$(backup_dir "$slug")"; out="$dir/$stamp-files.tar.gz"
  tar -C "/home/$user" -czf "$out.part" htdocs || { rm -f "$out.part"; die "tar 실패"; }
  mv "$out.part" "$out"
  finish_file "$out"
}

restore_files() {
  local slug="$1" file="$2" path user
  valid_backup_file "$file"; [[ "$file" == *-files.tar.gz ]] || die "파일 백업이 아닙니다"
  user="$(site_user_of "$slug")"; [[ -n "$user" ]] || die "사이트 유저가 없는 앱입니다"
  path="$BACKUPS/$slug/$file"; [[ -f "$path" && ! -L "$path" ]] || die "백업 파일이 없습니다"
  if tar -tzf "$path" | grep -Ev '^htdocs(/|$)' | grep -q . ; then die "아카이브에 허용되지 않은 경로가 있습니다"; fi
  if tar -tzf "$path" | grep -Eq '(^|/)\.\.(/|$)'; then die "아카이브에 .. 경로가 있습니다"; fi
  if tar -tvzf "$path" | grep -Eq '^[lhbcp]| link to '; then die "아카이브에 링크·특수 파일이 있습니다"; fi
  rm -rf --one-file-system "/home/$user/htdocs"
  # 사이트 유저 권한으로 풀어 소유권을 맞춤 (백업 파일은 사이트 유저가 못 읽으므로 root 가 stdin 으로 넘김)
  runuser -u "$user" -- tar -C "/home/$user" --no-same-owner -xzf - < "$path"
  echo "restored files from $file"
}

# ───────────────────────── Nginx 로그 ─────────────────────────

nginx_log() {
  local slug="$1" kind="$2" n="$3"
  [[ "$kind" == access || "$kind" == error ]] || die "kind must be access|error"
  [[ "$n" =~ ^[0-9]{1,5}$ ]] && (( n >= 1 && n <= 20000 )) || die "lines must be 1..20000"
  tail -n "$n" "/var/log/nginx/rpanel-$slug-$kind.log" 2>/dev/null || true
}

# ───────────────────────── main ─────────────────────────

main() {
cmd="${1:-}"; shift || true
case "$cmd" in
  prepare-app)
    valid_slug "${1:-}"
    install -d -o "$RUN_USER" -g "$RUN_USER" -m 0750 "$DATA/apps/$1/data"
    ;;
  install-unit) valid_slug "${1:-}"; install_unit "$1" ;;
  remove-unit)  valid_slug "${1:-}"; remove_unit "$1" ;;
  install-site) valid_slug "${1:-}"; install_site "$1" ;;
  remove-site)  valid_slug "${1:-}"; remove_site "$1" ;;
  svc)
    action="${1:-}"; valid_slug "${2:-}"
    [[ "$action" =~ ^(start|stop|restart)$ ]] || die "svc: action must be start|stop|restart"
    [[ -f "/etc/systemd/system/$(unit_name "$2")" ]] || die "unit not installed for $2"
    systemctl "$action" "$(unit_name "$2")"
    echo "$action $(unit_name "$2"): ok"
    ;;
  status)
    valid_slug "${1:-}"
    systemctl is-active "$(unit_name "$1")" 2>/dev/null || true
    ;;
  journal)
    valid_slug "${1:-}"; n="${2:-200}"
    [[ "$n" =~ ^[0-9]{1,4}$ ]] && (( n >= 1 && n <= 5000 )) || die "journal: lines must be 1..5000"
    journalctl -u "$(unit_name "$1")" -n "$n" --no-pager -o short-iso 2>/dev/null || true
    ;;
  install-cron) valid_slug "${1:-}"; valid_id "${2:-}"; install_cron "$1" "$2" ;;
  remove-cron)  valid_slug "${1:-}"; valid_id "${2:-}"; remove_cron "$1" "$2" ;;
  run-cron)
    valid_slug "${1:-}"; valid_id "${2:-}"
    [[ -f "/etc/systemd/system/$(cron_unit "$1" "$2").service" ]] || die "cron not installed"
    systemctl start --no-block "$(cron_unit "$1" "$2").service"; echo "started"
    ;;
  cron-status)
    valid_slug "${1:-}"; valid_id "${2:-}"
    systemctl show "$(cron_unit "$1" "$2").service" -p ActiveState -p Result -p ExecMainStatus -p ExecMainStartTimestamp -p ExecMainExitTimestamp 2>/dev/null || true
    systemctl show "$(cron_unit "$1" "$2").timer" -p NextElapseUSecRealtime -p LastTriggerUSec 2>/dev/null || true
    ;;
  cron-log)
    valid_slug "${1:-}"; valid_id "${2:-}"; n="${3:-100}"
    [[ "$n" =~ ^[0-9]{1,4}$ ]] && (( n >= 1 && n <= 5000 )) || die "lines must be 1..5000"
    journalctl -u "$(cron_unit "$1" "$2").service" -n "$n" --no-pager -o short-iso 2>/dev/null || true
    ;;
  db-create)   db_create "${1:-}" "${2:-}" ;;
  db-drop)     db_drop "${1:-}" "${2:-}" ;;
  db-password) db_password "${1:-}" "${2:-}" ;;
  backup-db)   valid_slug "${1:-}"; backup_db "$1" "${2:-}" "${3:-}" ;;
  backup-data) valid_slug "${1:-}"; backup_data "$1" "${2:-}" ;;
  restore-db)  valid_slug "${1:-}"; restore_db "$1" "${2:-}" "${3:-}" ;;
  restore-data) valid_slug "${1:-}"; restore_data "$1" "${2:-}" ;;
  nginx-log)   valid_slug "${1:-}"; nginx_log "$1" "${2:-}" "${3:-200}" ;;
  site-create)   valid_slug "${1:-}"; site_create "$1" "${2:-}" "${3:-}" "${4:-}" ;;
  site-password) valid_slug "${1:-}"; site_password "$1" ;;
  install-php-pool) valid_slug "${1:-}"; install_php_pool "$1" "${2:-}" ;;
  remove-php-pool)  valid_slug "${1:-}"; remove_php_pools "$1" ;;
  php-versions) php_versions ;;
  ssl-issue)   valid_slug "${1:-}"; slug="$1"; shift; ssl_issue "$slug" "$@" ;;
  ssl-custom)  valid_slug "${1:-}"; ssl_custom "$1" ;;
  ssl-info)    valid_slug "${1:-}"; ssl_info "$1" ;;
  ssl-remove)  valid_slug "${1:-}"; ssl_remove "$1" ;;
  backup-files)  valid_slug "${1:-}"; backup_files "$1" "${2:-}" ;;
  restore-files) valid_slug "${1:-}"; restore_files "$1" "${2:-}" ;;
  purge-app)
    valid_slug "${1:-}"
    remove_all_crons "$1"
    remove_unit "$1"
    remove_site "$1"
    ssl_remove "$1" >/dev/null
    site_delete "$1"
    rm -rf --one-file-system "$DATA/apps/$1" "$DATA/www/$1" "$DATA/builds/$1"
    rm -f "$DATA/keys/$1" "$DATA/keys/$1.pub" "$STAGING/$1.service" "$STAGING/$1.conf" "$STAGING/$1.php.conf" "$STAGING"/cron-"$1"-*
    # 백업 파일(/var/lib/rpanel/backups/<slug>)은 남겨 둡니다
    echo "purged $1"
    ;;
  *)
