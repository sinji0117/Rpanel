# /etc/rpanel/rpanel.env  (root:rpanel 0640)
# install.sh 가 자동으로 만들고 관리합니다 (DB·Redis 비밀번호, JWT 키 생성, 재실행해도 유지).
# 아래는 항목 설명용 예시입니다. 수정 후: sudo systemctl restart rpanel

DATABASE_URL=mysql://rpanel:<DB_비밀번호>@127.0.0.1:3306/rpanel
# 패널은 Redis DB 10 을 쓰고, 사이트에는 4~15 (패널 DB 제외)를 배정합니다
REDIS_URL=redis://:<Redis_비밀번호>@127.0.0.1:6379/10
JWT_SECRET=<openssl rand -hex 32>
BIND_ADDR=127.0.0.1:8090

# real: 실제로 실행 / dry-run: 명령을 로그로만 (둘러보기)
RPANEL_EXEC_MODE=real
# 패널은 HTTPS(8443) 로만 서비스되므로 true
COOKIE_SECURE=true

# direct: 이 서버가 80/443 을 직접 받음 (Let's Encrypt 사용)
# proxy : 앞단 프록시가 SSL 처리 → RPANEL_TRUSTED_PROXY 에 그 IP
RPANEL_EDGE_MODE=direct
RPANEL_TRUSTED_PROXY=
# 서버에 IPv6 가 없으면 false (install.sh 가 자동 감지)
RPANEL_IPV6=true

# 설치 옵션 — install.sh 가 저장하고 rpanel-update 때 그대로 다시 적용
RPANEL_ALLOW_FROM=
RPANEL_FIREWALL=1
RPANEL_SSH_PASSWORD=1
RPANEL_PANEL_DOMAIN=
RPANEL_EMAIL=

RUST_LOG=info
# Rust·Python 앱·사이트 포트 자동 할당 범위
RPANEL_APP_PORT_MIN=8100
RPANEL_APP_PORT_MAX=8999
RPANEL_MAX_CONCURRENT_BUILDS=2
# 예약 백업 시각 (0~23시)
RPANEL_BACKUP_HOUR=3

# (선택) 프록시 뒤에서 빌드할 때 git/cargo/npm 에 넘길 환경변수 이름 — 값은 이 파일에 함께 적으세요
# RPANEL_PASS_ENV=HTTPS_PROXY,NO_PROXY,SSL_CERT_FILE

# 새 버전 확인에 쓰는 GitHub 저장소 (비우면 확인 안 함)
# RPANEL_UPDATE_REPO=sinji0117/Rpanel
