# /etc/rpanel/rpanel.env  (root:rpanel 0640)
# install.sh 가 처음 한 번 생성합니다. 비밀번호는 Vol.6 §9.7 / §9.7.1 과 같은 방식으로 만든 값을 넣으세요.

# MariaDB — 패널 전용 DB/계정 (§9.7 과 같은 방식으로 생성)
DATABASE_URL=mysql://rpanel:<DB_비밀번호>@127.0.0.1:3306/rpanel

# Redis — 앱들이 /0~/3 을 쓰므로 패널은 /10 사용 (§9.14.6 표 참고)
REDIS_URL=redis://:<Redis_비밀번호>@127.0.0.1:6379/10

# openssl rand -hex 32
JWT_SECRET=<64자_hex>

BIND_ADDR=127.0.0.1:8090
RUST_LOG=info

# real: 실제 배포 실행 / dry-run: 명령을 로그로만 (처음 둘러볼 때)
RPANEL_EXEC_MODE=real

# 앱 포트 자동 할당 범위 (Vol.6 수동 앱 8080~8083 과 겹치지 않게)
RPANEL_APP_PORT_MIN=8100
RPANEL_APP_PORT_MAX=8999

# 앱 Nginx 설정의 set_real_ip_from (CT100 프록시)
RPANEL_TRUSTED_PROXY=10.0.0.10

# 동시 빌드 수 (8 vCPU / 16GB 기준 2)
RPANEL_MAX_CONCURRENT_BUILDS=2

# Tailscale로 http://10.0.0.12:9000 접속 → false
# CT100(NPM)을 거쳐 https 도메인으로 접속하게 만들었다면 → true
COOKIE_SECURE=false
